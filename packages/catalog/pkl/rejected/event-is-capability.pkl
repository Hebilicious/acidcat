// pkl eval fails with: Type constraint `idsAreNotCapabilities(this)` violated.
amends "../Catalog.pkl"

targets { ["cli"] { surfaces { "cli" } } }
capabilities { ["shop.item.get"] { description = "Get an item."; audience { "cli" } } }
events { ["shop.item.get"] { description = "An item is read."; audience { "cli" } } }
