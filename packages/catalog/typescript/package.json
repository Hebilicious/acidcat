    "directory": "packages/catalog/typescript"
  },
  "homepage": "https://github.com/Hebilicious/acidcat/tree/main/packages/catalog/typescript#readme",
  "bugs": "https://github.com/Hebilicious/acidcat/issues",
  "type": "module",
