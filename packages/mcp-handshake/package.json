{
  "name": "@acid-cat/mcp-handshake",
  "version": "0.10.0",
  "description": "Serve MCP clients of the revisions with an initialize handshake from an AcidCat MCP server through HTTP, with no state. Part of the TypeScript reference implementation.",
  "keywords": [
    "acidcat",
    "mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hebilicious/acidcat.git",
    "directory": "packages/mcp-handshake"
  },
  "homepage": "https://github.com/Hebilicious/acidcat/tree/main/packages/mcp-handshake#readme",
  "bugs": "https://github.com/Hebilicious/acidcat/issues",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "exports": "./src/index.ts",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@acid-cat/spec-ts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
