{
  "name": "@acid-cat/core-effect",
  "version": "0.5.0",
  "description": "Serve AcidCat capabilities, written fully in Effect.",
  "keywords": [
    "acidcat",
    "effect",
    "mcp",
    "webmcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hebilicious/acidcat.git",
    "directory": "packages/core-effect"
  },
  "homepage": "https://github.com/Hebilicious/acidcat/tree/main/packages/core-effect#readme",
  "bugs": "https://github.com/Hebilicious/acidcat/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./App": "./src/App.ts",
    "./Capability": "./src/Capability.ts",
    "./Session": "./src/Session.ts",
    "./Handles": "./src/Handles.ts",
    "./Mcp": "./src/Mcp.ts",
    "./Http": "./src/Http.ts",
    "./Cli": "./src/Cli.ts",
    "./WebMcp": "./src/WebMcp.ts",
    "./node": "./src/node.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./App": {
        "types": "./dist/App.d.ts",
        "default": "./dist/App.js"
      },
      "./Capability": {
        "types": "./dist/Capability.d.ts",
        "default": "./dist/Capability.js"
      },
      "./Session": {
        "types": "./dist/Session.d.ts",
        "default": "./dist/Session.js"
      },
      "./Handles": {
        "types": "./dist/Handles.d.ts",
        "default": "./dist/Handles.js"
      },
      "./Mcp": {
        "types": "./dist/Mcp.d.ts",
        "default": "./dist/Mcp.js"
      },
      "./Http": {
        "types": "./dist/Http.d.ts",
        "default": "./dist/Http.js"
      },
      "./Cli": {
        "types": "./dist/Cli.d.ts",
        "default": "./dist/Cli.js"
      },
      "./WebMcp": {
        "types": "./dist/WebMcp.d.ts",
        "default": "./dist/WebMcp.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      }
    }
  },
  "dependencies": {
    "@acid-cat/catalog": "workspace:*",
    "@acid-cat/spec-ts": "workspace:*"
  },
  "peerDependencies": {
    "@effect/platform-node": "catalog:peers",
    "effect": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "@effect/platform-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@acid-cat/cli": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "esbuild": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:"
  }
}
