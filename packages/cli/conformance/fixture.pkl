/// The conformance fixture. Each implementation serves this catalog, and `acid-cat conform` tests it through
/// its bindings. Each capability shows one behavior.
amends "../../catalog/pkl/Catalog.pkl"

title = "AcidCat conformance fixture"
description = "One capability or event for each behavior that acid-cat conform tests."

targets {
  ["app"] { bindings { "typescript"; "webmcp" } }
  ["mcp"] { bindings { "mcp" } }
  ["cli"] { bindings { "cli" } }
  ["api"] { bindings { "http" } }
}

local allTargets = new Listing { "app"; "mcp"; "cli"; "api" }

local text = new Dynamic {
  type = "object"
  required { "text" }
  properties { text { type = "string" } }
}

local key = new Dynamic {
  type = "object"
  required { "key" }
  properties { key { type = "string" } }
}

local keys = new Dynamic {
  type = "object"
  required { "keys" }
  properties { keys { type = "array"; items { type = "string" } } }
}

local tick = new Dynamic {
  type = "object"
  required { "n" }
  properties { n { type = "integer" } }
}

local flags = new Dynamic {
  type = "object"
  required { "mode" }
  properties {
    mode { type = "string"; `enum` { "fast"; "slow" } }
    count { type = "integer" }
    ratio { type = "number" }
    label { type = "string" }
    verbose { type = "boolean" }
    extra { type = "object" }
    steps { type = "array"; items { type = "integer" } }
    tags { type = "array"; items { type = "string" } }
  }
}

capabilities {
  ["fixture.echo"] {
    description = "Return the input text."
    audience = allTargets
    readOnly = true
    input = text
    output = text
  }
  ["fixture.refuse"] {
    description = "Always return the failure Refused."
    audience = allTargets
    failures {
      ["Refused"] {
        type = "object"
        required { "_tag"; "reason" }
        properties {
          _tag { type = "string"; `const` = "Refused" }
          reason { type = "string" }
        }
      }
    }
  }
  ["fixture.crash"] {
    description = "Always fail with a defect."
    audience = allTargets
  }
  ["fixture.hold"] {
    description = "Hold until fixture.release releases the key, then return the key. While the call holds, fixture.held gives the key. With a marker, the call writes a file at that path when it starts to hold."
    audience = allTargets
    input {
      type = "object"
      required { "key" }
      properties {
        key { type = "string" }
        marker { type = "string" }
      }
    }
    output = key
  }
  ["fixture.held"] {
    description = "Return the keys of the calls to fixture.hold that hold now."
    audience = allTargets
    readOnly = true
    output = keys
  }
  ["fixture.release"] {
    description = "Release the calls to fixture.hold that hold the key."
    audience = allTargets
    input = key
  }
  ["fixture.hidden"] {
    description = "Only the app target can use this capability."
    audience { "app" }
  }
  ["fixture.toggle"] {
    description = "Available only while the switch is on."
    audience = allTargets
    input {
      type = "object"
      properties {}
    }
  }
  ["fixture.switch.set"] {
    description = "Turn the switch on or off. The switch controls the availability of fixture.toggle."
    audience = allTargets
    input {
      type = "object"
      required { "on" }
      properties { on { type = "boolean" } }
    }
  }
  ["fixture.flags"] {
    description = "Return the input. The input has one property for each kind of command-line flag."
    audience { "cli" }
    input = flags
    output = flags
  }
  ["fixture.signal"] {
    description = "Give an occurrence of fixture.watch to each subscription that watches the key. Return the number of these subscriptions."
    audience = allTargets
    input {
      type = "object"
      required { "key"; "value" }
      properties {
        key { type = "string" }
        value { type = "string" }
      }
    }
    output {
      type = "object"
      required { "delivered" }
      properties { delivered { type = "integer" } }
    }
  }
  ["fixture.watching"] {
    description = "Return the keys of the subscriptions to fixture.watch that are active now."
    audience = allTargets
    readOnly = true
    output = keys
  }
}

events {
  ["fixture.ticks"] {
    description = "Give the occurrences n = 1 to count, with the eventId and the cursor String(n), then end. With a cursor c, start at c + 1. With a gap g, the occurrence n = g has truncated: true, as if the source skipped occurrences before it. The key changes nothing: it gives the subscriptions of each test their own input."
    audience = allTargets
    input {
      type = "object"
      required { "count" }
      properties {
        count { type = "integer"; minimum = 0; maximum = 100 }
        gap { type = "integer"; minimum = 1; maximum = 100 }
        key { type = "string" }
      }
    }
    payload = tick
  }
  ["fixture.watch"] {
    description = "Give an occurrence each time that fixture.signal gets the key. Never end. With a marker, write a file at that path when the subscription starts."
    audience = allTargets
    input {
      type = "object"
      required { "key" }
      properties {
        key { type = "string" }
        marker { type = "string" }
      }
    }
    payload {
      type = "object"
      required { "key"; "value" }
      properties {
        key { type = "string" }
        value { type = "string" }
      }
    }
  }
  ["fixture.broken"] {
    description = "Give the occurrence n = 1, then fail with a defect."
    audience = allTargets
    payload = tick
  }
  ["fixture.secret"] {
    description = "Only the app target can follow this event. It never gives an occurrence."
    audience { "app" }
  }
}
