{
  "acidcat": "0.1",
  "targets": { "shop": { "surfaces": ["mcp"] } },
  "capabilities": {
    "shop.order.place": {
      "description": "Place an order.",
      "audience": ["shop"],
      "input": {
        "type": "object",
        "properties": {
          "price": { "type": "number", "x-mcp-header": "Price" },
          "note": { "type": "string", "x-mcp-header": "" },
          "shop": { "type": "string", "x-mcp-header": "Shop Name" },
          "region": { "type": "string", "x-mcp-header": "Region" },
          "address": { "type": "object", "properties": { "region": { "type": "string", "x-mcp-header": "region" } } }
        }
      }
    }
  }
}
