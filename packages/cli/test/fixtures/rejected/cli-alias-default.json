{
  "acidcat": "0.1",
  "targets": {
    "shop": {
      "bindings": [
        "cli"
      ],
      "options": {
        "cli": {
          "aliases": {
            "--fresh": {
              "capability": "shop.item.get"
            },
            "orders": {
              "event": "shop.order.gone"
            }
          },
          "default": "fresh"
        }
      }
    }
  },
  "capabilities": {
    "shop.item.get": {
      "description": "Get an item.",
      "audience": [
        "shop"
      ]
    }
  }
}
