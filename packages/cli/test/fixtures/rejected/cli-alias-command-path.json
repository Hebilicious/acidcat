{
  "acidcat": "0.1",
  "targets": {
    "cli": {
      "bindings": [
        "cli"
      ],
      "options": {
        "cli": {
          "aliases": {
            "inbox": {
              "capability": "inbox.list"
            },
            "inbox adopt": {
              "capability": "inbox.adopt"
            },
            "inbox all": {
              "capability": "inbox.list"
            }
          },
          "default": "inbox"
        }
      }
    }
  },
  "capabilities": {
    "inbox.adopt": {
      "description": "Adopt an entry of the inbox.",
      "audience": [
        "cli"
      ]
    },
    "inbox.reject": {
      "description": "Reject an entry of the inbox.",
      "audience": [
        "cli"
      ]
    },
    "inbox.list": {
      "description": "List the entries of the inbox.",
      "audience": [
        "cli"
      ]
    }
  }
}
