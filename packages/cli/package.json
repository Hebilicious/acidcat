{
  "name": "@acid-cat/cli",
  "version": "0.1.0",
  "description": "The AcidCat command line: check, format and view catalogs, and test implementations.",
  "keywords": [
    "acidcat",
    "cli",
    "conformance"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hebilicious/acidcat.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Hebilicious/acidcat/tree/main/packages/cli#readme",
  "bugs": "https://github.com/Hebilicious/acidcat/issues",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "conformance/fixture.acidcat.json"
  ],
  "bin": {
    "acid-cat": "./src/main.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./conformance/fixture.acidcat.json": "./conformance/fixture.acidcat.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./conformance/fixture.acidcat.json": "./conformance/fixture.acidcat.json"
    },
    "bin": {
      "acid-cat": "./dist/main.js"
    }
  },
  "dependencies": {
    "@acid-cat/catalog": "workspace:*",
    "@acid-cat/spec-ts": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:"
  },
  "peerDependencies": {
    "playwright": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:"
  }
}
