{
  "name": "@acid-cat/cli",
  "version": "0.1.0",
  "description": "The AcidCat command line: check, format and view catalogs, and test implementations.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "acid-cat": "./src/main.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./conformance/fixture.acidcat.json": "./conformance/fixture.acidcat.json"
  },
  "dependencies": {
    "@acid-cat/catalog": "workspace:*",
    "@acid-cat/spec": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "playwright": "catalog:"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
