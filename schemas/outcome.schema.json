{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acidcat.dev/schemas/0.1/outcome.schema.json",
  "title": "AcidCat outcome",
  "description": "The JSON form of an invocation's outcome: a value, a failure, or a call failure. See spec/invocation.md.",
  "oneOf": [
    {
      "title": "Value",
      "type": "object",
      "required": ["ok", "value"],
      "properties": { "ok": { "const": true }, "value": true },
      "additionalProperties": false
    },
    {
      "title": "Failure",
      "type": "object",
      "required": ["ok", "error"],
      "properties": {
        "ok": { "const": false },
        "error": {
          "type": "object",
          "required": ["_tag"],
          "properties": { "_tag": { "type": "string", "minLength": 1 } }
        }
      },
      "additionalProperties": false
    },
    {
      "title": "Call failure",
      "type": "object",
      "required": ["kind", "message"],
      "properties": {
        "kind": { "enum": ["cancelled", "unknown-capability", "unavailable", "invalid-input", "internal"] },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    }
  ]
}
