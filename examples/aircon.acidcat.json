{
  "acidcat": "0.1",
  "title": "Living-room air conditioner",
  "description": "Control and monitor one split-unit air conditioner on the home network.",
  "targets": {
    "app": {
      "bindings": [
        "typescript",
        "acme:swift",
        "acme:kotlin"
      ],
      "description": "The phone, desktop and web apps that people use."
    },
    "taskbar": {
      "bindings": [
        "typescript"
      ],
      "description": "A desktop taskbar widget showing the status and a power toggle."
    },
    "cli": {
      "bindings": [
        "cli"
      ]
    },
    "mcp": {
      "bindings": [
        "mcp"
      ],
      "description": "Agents, through an MCP server."
    },
    "api": {
      "bindings": [
        "http",
        "graphql"
      ],
      "description": "Home-automation systems and scripts."
    }
  },
  "capabilities": {
    "aircon.status.get": {
      "description": "Read the unit's power, mode, fan speed, target temperature and room temperature.",
      "audience": [
        "app",
        "taskbar",
        "cli",
        "mcp",
        "api"
      ],
      "output": {
        "title": "Status",
        "type": "object",
        "required": [
          "power",
          "mode",
          "fan",
          "targetCelsius",
          "roomCelsius"
        ],
        "properties": {
          "power": {
            "type": "boolean"
          },
          "mode": {
            "enum": [
              "cool",
              "heat",
              "dry",
              "fan",
              "auto"
            ]
          },
          "fan": {
            "enum": [
              "auto",
              "low",
              "medium",
              "high"
            ]
          },
          "targetCelsius": {
            "type": "number"
          },
          "roomCelsius": {
            "type": "number"
          }
        }
      },
      "failures": {
        "Offline": {
          "type": "object",
          "properties": {
            "since": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      },
      "readOnly": true,
      "state": {
        "title": "Status",
        "type": "object",
        "required": [
          "power",
          "mode",
          "fan",
          "targetCelsius",
          "roomCelsius"
        ],
        "properties": {
          "power": {
            "type": "boolean"
          },
          "mode": {
            "enum": [
              "cool",
              "heat",
              "dry",
              "fan",
              "auto"
            ]
          },
          "fan": {
            "enum": [
              "auto",
              "low",
              "medium",
              "high"
            ]
          },
          "targetCelsius": {
            "type": "number"
          },
          "roomCelsius": {
            "type": "number"
          }
        }
      }
    },
    "aircon.power.set": {
      "description": "Turn the unit on or off.",
      "audience": [
        "app",
        "taskbar",
        "cli",
        "mcp",
        "api"
      ],
      "input": {
        "type": "object",
        "required": [
          "on"
        ],
        "properties": {
          "on": {
            "type": "boolean"
          }
        }
      },
      "failures": {
        "Offline": {
          "type": "object",
          "properties": {
            "since": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "aircon.mode.set": {
      "description": "Choose how the unit runs.",
      "audience": [
        "app",
        "cli",
        "mcp",
        "api"
      ],
      "input": {
        "type": "object",
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "enum": [
              "cool",
              "heat",
              "dry",
              "fan",
              "auto"
            ]
          }
        }
      },
      "failures": {
        "Offline": {
          "type": "object",
          "properties": {
            "since": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "PoweredOff": {
          "type": "object",
          "description": "The unit must be on before its mode can change."
        }
      }
    },
    "aircon.temperature.set": {
      "description": "Set the target temperature in degrees Celsius.",
      "audience": [
        "app",
        "cli",
        "mcp",
        "api"
      ],
      "input": {
        "type": "object",
        "required": [
          "celsius"
        ],
        "properties": {
          "celsius": {
            "type": "number",
            "minimum": 16,
            "maximum": 31
          }
        }
      },
      "failures": {
        "Offline": {
          "type": "object",
          "properties": {
            "since": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "aircon.fan.set": {
      "description": "Set the fan speed.",
      "audience": [
        "app",
        "cli",
        "mcp",
        "api"
      ],
      "input": {
        "type": "object",
        "required": [
          "speed"
        ],
        "properties": {
          "speed": {
            "enum": [
              "auto",
              "low",
              "medium",
              "high"
            ]
          }
        }
      },
      "failures": {
        "Offline": {
          "type": "object",
          "properties": {
            "since": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "aircon.firmware.update": {
      "description": "Install the latest firmware. The unit restarts and is offline for about a minute.",
      "audience": [
        "app"
      ],
      "failures": {
        "Offline": {
          "type": "object",
          "properties": {
            "since": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "UpToDate": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
