{
  "acidcat": "0.1",
  "title": "Living-room air conditioner",
  "description": "Control and monitor one split-unit air conditioner on the home network.",
  "targets": {
    "app": {
      "bindings": [
        "typescript",
        "acme:swift",
        "acme:kotlin"
      ],
      "description": "The phone, desktop and web apps that people use."
    },
    "taskbar": {
      "bindings": [
        "typescript"
      ],
      "description": "A desktop taskbar widget showing the status and a power toggle."
    },
    "cli": {
      "bindings": [
        "cli"
      ]
    },
    "mcp": {
      "bindings": [
        "mcp"
      ],
      "description": "Agents, through an MCP server."
    },
    "api": {
      "bindings": [
        "http",
        "graphql"
      ],
      "description": "Home-automation systems and scripts."
    }
  },
  "$defs": {
    "Mode": {
      "enum": [
        "cool",
        "heat",
        "dry",
        "fan",
        "auto"
      ]
    },
    "FanSpeed": {
      "enum": [
        "auto",
        "low",
        "medium",
        "high"
      ]
    },
    "Status": {
      "type": "object",
      "required": [
        "power",
        "mode",
        "fan",
        "targetCelsius",
        "roomCelsius"
      ],
      "properties": {
        "power": {
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "fan": {
          "$ref": "#/$defs/FanSpeed"
        },
        "targetCelsius": {
          "type": "number"
        },
        "roomCelsius": {
          "type": "number"
        }
      }
    },
    "Offline": {
      "type": "object",
      "properties": {
        "since": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "capabilities": {
    "aircon.status.get": {
      "description": "Read the unit's power, mode, fan speed, target temperature and room temperature.",
      "audience": [
        "app",
        "taskbar",
        "cli",
        "mcp",
        "api"
      ],
      "output": {
        "$ref": "#/$defs/Status"
      },
      "failures": {
        "Offline": {
          "$ref": "#/$defs/Offline"
        }
      },
      "readOnly": true,
      "state": {
        "$ref": "#/$defs/Status"
      }
    },
    "aircon.power.set": {
      "description": "Turn the unit on or off.",
      "audience": [
        "app",
        "taskbar",
        "cli",
        "mcp",
        "api"
      ],
      "input": {
        "type": "object",
        "required": [
          "on"
        ],
        "properties": {
          "on": {
            "type": "boolean"
          }
        }
      },
      "failures": {
        "Offline": {
          "$ref": "#/$defs/Offline"
        }
      }
    },
    "aircon.mode.set": {
      "description": "Choose how the unit runs.",
      "audience": [
        "app",
        "cli",
        "mcp",
        "api"
      ],
      "input": {
        "type": "object",
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "$ref": "#/$defs/Mode"
          }
        }
      },
      "failures": {
        "Offline": {
          "$ref": "#/$defs/Offline"
        },
        "PoweredOff": {
          "type": "object",
          "description": "The unit must be on before its mode can change."
        }
      }
    },
    "aircon.temperature.set": {
      "description": "Set the target temperature in degrees Celsius.",
      "audience": [
        "app",
        "cli",
        "mcp",
        "api"
      ],
      "input": {
        "type": "object",
        "required": [
          "celsius"
        ],
        "properties": {
          "celsius": {
            "type": "number",
            "minimum": 16,
            "maximum": 31
          }
        }
      },
      "failures": {
        "Offline": {
          "$ref": "#/$defs/Offline"
        }
      }
    },
    "aircon.fan.set": {
      "description": "Set the fan speed.",
      "audience": [
        "app",
        "cli",
        "mcp",
        "api"
      ],
      "input": {
        "type": "object",
        "required": [
          "speed"
        ],
        "properties": {
          "speed": {
            "$ref": "#/$defs/FanSpeed"
          }
        }
      },
      "failures": {
        "Offline": {
          "$ref": "#/$defs/Offline"
        }
      }
    },
    "aircon.firmware.update": {
      "description": "Install the latest firmware. The unit restarts and is offline for about a minute.",
      "audience": [
        "app"
      ],
      "failures": {
        "Offline": {
          "$ref": "#/$defs/Offline"
        },
        "UpToDate": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
