{
  "acidcat": "0.1",
  "title": "Living-room air conditioner",
  "description": "Control and monitor one split-unit air conditioner on the home network.",
  "targets": {
    "api": {
      "bindings": [
        "http"
      ],
      "description": "Home-automation systems and scripts."
    },
    "app": {
      "bindings": [
        "typescript",
        "webmcp",
        "acme:swift",
        "acme:kotlin"
      ],
      "description": "The phone, desktop and web apps that people use."
    },
    "cli": {
      "bindings": [
        "cli"
      ],
      "options": {
        "cli": {
          "aliases": {
            "--off": {
              "capability": "aircon.power.set",
              "input": {
                "on": false
              }
            },
            "--on": {
              "capability": "aircon.power.set",
              "input": {
                "on": true
              }
            },
            "fan": {
              "capability": "aircon.fan.set"
            },
            "fan auto": {
              "capability": "aircon.fan.set",
              "input": {
                "speed": "auto"
              }
            },
            "fan high": {
              "capability": "aircon.fan.set",
              "input": {
                "speed": "high"
              }
            },
            "follow": {
              "event": "aircon.status.changed"
            },
            "status": {
              "capability": "aircon.status.get"
            }
          },
          "default": "status"
        }
      }
    },
    "mcp": {
      "bindings": [
        "mcp"
      ],
      "description": "Agents, through an MCP server."
    },
    "taskbar": {
      "bindings": [
        "typescript"
      ],
      "description": "A desktop taskbar widget showing the status and a power toggle."
    }
  },
  "$defs": {
    "Day": {
      "enum": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ]
    },
    "FanSpeed": {
      "enum": [
        "auto",
        "low",
        "medium",
        "high"
      ]
    },
    "Mode": {
      "enum": [
        "cool",
        "heat",
        "dry",
        "fan",
        "auto"
      ]
    },
    "Offline": {
      "properties": {
        "since": {
          "format": "date-time",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Schedule": {
      "properties": {
        "days": {
          "items": {
            "$ref": "#/$defs/Day"
          },
          "type": "array"
        },
        "hours": {
          "items": {
            "maximum": 23,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "days",
        "hours"
      ],
      "type": "object"
    },
    "Status": {
      "properties": {
        "fan": {
          "$ref": "#/$defs/FanSpeed"
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "power": {
          "type": "boolean"
        },
        "roomCelsius": {
          "type": "number"
        },
        "targetCelsius": {
          "type": "number"
        }
      },
      "required": [
        "power",
        "mode",
        "fan",
        "targetCelsius",
        "roomCelsius"
      ],
      "type": "object"
    }
  },
  "capabilities": {
    "aircon.fan.set": {
      "description": "Set the fan speed.",
      "audience": [
        "app",
        "cli",
        "mcp",
        "api"
      ],
      "input": {
        "properties": {
          "speed": {
            "$ref": "#/$defs/FanSpeed"
          }
        },
        "required": [
          "speed"
        ],
        "type": "object"
      },
      "failures": {
        "Offline": {
          "$ref": "#/$defs/Offline"
        }
      },
      "destructive": true,
      "idempotent": true
    },
    "aircon.firmware.update": {
      "description": "Install the latest firmware. The unit restarts and is offline for about a minute.",
      "audience": [
        "app"
      ],
      "failures": {
        "Offline": {
          "$ref": "#/$defs/Offline"
        },
        "UpToDate": {
          "properties": {
            "version": {
              "type": "string"
            }
          },
          "required": [
            "version"
          ],
          "type": "object"
        }
      }
    },
    "aircon.mode.set": {
      "description": "Choose how the unit runs.",
      "audience": [
        "app",
        "cli",
        "mcp",
        "api"
      ],
      "input": {
        "properties": {
          "mode": {
            "$ref": "#/$defs/Mode"
          }
        },
        "required": [
          "mode"
        ],
        "type": "object"
      },
      "failures": {
        "Offline": {
          "$ref": "#/$defs/Offline"
        },
        "PoweredOff": {
          "description": "The unit must be on before its mode can change.",
          "type": "object"
        }
      },
      "destructive": true,
      "idempotent": true
    },
    "aircon.power.set": {
      "description": "Turn the unit on or off.",
      "audience": [
        "app",
        "taskbar",
        "cli",
        "mcp",
        "api"
      ],
      "input": {
        "properties": {
          "on": {
            "type": "boolean"
          }
        },
        "required": [
          "on"
        ],
        "type": "object"
      },
      "failures": {
        "Offline": {
          "$ref": "#/$defs/Offline"
        }
      },
      "destructive": true,
      "idempotent": true
    },
    "aircon.schedule.set": {
      "description": "Turn the unit on at each given hour, on each given day. The default hour is 7.",
      "audience": [
        "app",
        "cli",
        "mcp",
        "api"
      ],
      "input": {
        "properties": {
          "days": {
            "items": {
              "$ref": "#/$defs/Day"
            },
            "type": "array"
          },
          "hours": {
            "items": {
              "maximum": 23,
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          }
        },
        "required": [
          "days"
        ],
        "type": "object"
      },
      "output": {
        "$ref": "#/$defs/Schedule"
      },
      "failures": {
        "Offline": {
          "$ref": "#/$defs/Offline"
        }
      },
      "destructive": true,
      "idempotent": true
    },
    "aircon.status.export": {
      "description": "Write the status to a JSON file. A cancelled call can still write the file.",
      "audience": [
        "cli"
      ],
      "input": {
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "failures": {
        "Offline": {
          "$ref": "#/$defs/Offline"
        },
        "WriteFailed": {
          "type": "object"
        }
      }
    },
    "aircon.status.get": {
      "description": "Read the unit's power, mode, fan speed, target temperature and room temperature.",
      "audience": [
        "app",
        "taskbar",
        "cli",
        "mcp",
        "api"
      ],
      "output": {
        "$ref": "#/$defs/Status"
      },
      "failures": {
        "Offline": {
          "$ref": "#/$defs/Offline"
        }
      },
      "readOnly": true,
      "state": {
        "$ref": "#/$defs/Status"
      }
    },
    "aircon.temperature.set": {
      "description": "Set the target temperature in degrees Celsius.",
      "audience": [
        "app",
        "cli",
        "mcp",
        "api"
      ],
      "input": {
        "properties": {
          "celsius": {
            "maximum": 31,
            "minimum": 16,
            "type": "number"
          }
        },
        "required": [
          "celsius"
        ],
        "type": "object"
      },
      "failures": {
        "Offline": {
          "$ref": "#/$defs/Offline"
        }
      },
      "destructive": true,
      "idempotent": true
    }
  },
  "events": {
    "aircon.status.changed": {
      "description": "The status of the unit changed.",
      "audience": [
        "app",
        "taskbar",
        "cli",
        "mcp",
        "api"
      ],
      "input": {
        "properties": {},
        "type": "object"
      },
      "payload": {
        "$ref": "#/$defs/Status"
      }
    }
  }
}
