moon = "2.5.6"
node = "26.10.0"
pnpm = "12.8.1"
pkl = "0.32.1"
python = "3.14.0"
go = "1.27.2"
rust = "1.99.0"
uv = "0.13.1"
java = "temurin-21.0.12+8"
gradle = "9.8.2"

[plugins.tools]
pkl = "https://raw.githubusercontent.com/milesj/proto-plugins/refs/heads/master/pkl.toml"
gradle = "https://raw.githubusercontent.com/eplightning/openjdk-adoptium-proto-plugin/main/build-plugins/gradle.toml"

[settings]
detect-strategy = "prefer-prototools"
auto-install = true
telemetry = false
