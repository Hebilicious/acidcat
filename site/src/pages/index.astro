---
import "../styles/tokens.css";
import "../styles/home.css";
import LivingPlate from "../components/LivingPlate.astro";
import NixieTubes from "../components/NixieTubes.astro";
import Mark from "../components/Mark.astro";
import Schematic from "../components/Schematic.astro";

const repository = "https://github.com/Hebilicious/acidcat";
const title = "AcidCat — One catalog. Every surface.";
const description = "Describe what your application can do once. Serve it as a CLI, an MCP server, an HTTP API and typed client code.";

const parts = [
  {
    number: "I",
    name: "Catalog",
    text: "The contract, stored as JSON. Write it in the typed language of your choice. It is checked at build time; programs do not read it at run time.",
    image: "catalog",
  },
  {
    number: "II",
    name: "Binding",
    text: "The rules for one surface: CLI, MCP, HTTP, WebMCP or a language such as TypeScript. The specification defines each one.",
    image: "bindings",
  },
  {
    number: "III",
    name: "Core",
    text: "A library that runs your capabilities and serves the bindings. One core for Effect, one for plain TypeScript, one for Rust.",
    image: "core",
  },
  {
    number: "IV",
    name: "acid-cat conform",
    text: "Tests a running program from the outside, through each binding. Any program that passes it is an implementation.",
    image: "conform",
  },
];

const features = [
  { title: "Each target sees only its own capabilities", text: "A capability that writes a local file can belong to the cli target alone.", example: 'aircon.status.export   audience: ["cli"]' },
  { title: "Failures are typed data", text: "Each failure has a tag. An unexpected error becomes the call failure internal, and its details stay on the server.", example: "failures: { Offline }   else: internal" },
  { title: "Events stream to subscribers", text: "Occurrences such as aircon.status.changed reach the CLI, MCP, HTTP through server-sent events, and TypeScript.", example: "$ home follow   # aircon.status.changed" },
  { title: "Agents know what is dangerous", text: "MCP clients get destructiveHint and idempotentHint, so an agent knows to ask before it turns the unit off.", example: "destructiveHint: true   idempotentHint: true" },
  { title: "WebMCP in the browser", text: "A browser agent calls the capabilities of your page directly, with the session of the signed-in user.", example: "document.modelContext.registerTool(tool)" },
  { title: "Built for pipes", text: "In a pipe, the command line writes each result as one line of JSON, so an agent or a script reads less text.", example: "$ home status | jq .on" },
];

const languages = [
  { code: "TS", name: "TypeScript" },
  { code: "PY", name: "Python" },
  { code: "GO", name: "Go" },
  { code: "RS", name: "Rust" },
  { code: "PKL", name: "Pkl" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0e14" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <a class="brand" href="/" aria-label="AcidCat home">
        <Mark size={34} />
        <span>AcidCat</span>
      </a>
      <nav aria-label="Main">
        <a href="/docs/">Docs</a>
        <a href={`${repository}/blob/main/spec/README.md`}>Spec</a>
        <a href={`${repository}/blob/main/packages/README.md`}>Packages</a>
        <a class="nav-github" href={repository}>GitHub</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-stage">
          <LivingPlate />
        </div>
        <div class="hero-copy">
          <p class="eyebrow reveal">An open specification · 0.1 draft</p>
          <h1 id="hero-title" class="reveal">
            One catalog.
            <em>Every surface.</em>
          </h1>
          <div class="ornament reveal" aria-hidden="true">
            <span></span>
            <svg viewBox="0 0 24 24" width="22" height="22"><circle cx="12" cy="12" r="5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M12 1v5M12 18v5M1 12h5M18 12h5M4.2 4.2l3.5 3.5M16.3 16.3l3.5 3.5M4.2 19.8l3.5-3.5M16.3 7.7l3.5-3.5" stroke="currentColor" stroke-width="2" /></svg>
            <span></span>
          </div>
          <p class="hero-lede reveal">
            Describe what your application can do once. Serve it as a <strong>CLI</strong>, an <strong>MCP server</strong>, an <strong>HTTP API</strong> and <strong>typed client code</strong>. Every surface takes the same input and returns the same failures.
          </p>
          <div class="actions reveal">
            <a class="button button-acid" href="/docs/">Get started</a>
            <a class="button button-brass" href={`${repository}/blob/main/spec/README.md`}>Read the spec</a>
          </div>
          <div class="install reveal">
            <span class="prompt" aria-hidden="true">$</span>
            <code>npx @acid-cat/cli check aircon.acidcat.json</code>
            <button class="copy" type="button" data-copy="npx @acid-cat/cli check aircon.acidcat.json" aria-label="Copy the command">Copy</button>
          </div>
        </div>
      </section>

      <Schematic />

      <section class="parts" aria-labelledby="parts-title">
        <header class="section-head">
          <p class="eyebrow">Fig. 2 — Parts list</p>
          <h2 id="parts-title">Four parts. <em>No magic.</em></h2>
          <p class="lede">The specification comes first. The packages in the repository are one implementation of it, and an implementation in any language can replace them.</p>
        </header>
        <ol class="parts-grid">
          {parts.map((part) => (
            <li class="part">
              <div class="part-icon" aria-hidden="true">
                <img src={`/parts/${part.image}.webp`} alt="" width="560" height="300" loading="lazy" decoding="async" />
              </div>
              <span class="part-number">{part.number}</span>
              <h3>{part.name}</h3>
              <p>{part.text}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="features" aria-labelledby="features-title">
        <header class="section-head">
          <p class="eyebrow">Fig. 3 — Pressure-tested</p>
          <h2 id="features-title">What every surface <em>gets for free.</em></h2>
        </header>
        <ul class="feature-grid">
          {features.map((feature, index) => (
            <li class="feature" style={`--i:${index}`} tabindex="0" data-feature>
              <span class="feature-tube" aria-hidden="true"><span></span><i></i><i></i><i></i></span>
              <h3>{feature.title}</h3>
              <p>{feature.text}</p>
              <code class="feature-readout">{feature.example}</code>
            </li>
          ))}
        </ul>
      </section>

      <section class="languages" aria-labelledby="languages-title">
        <div class="languages-inner">
          <div>
            <p class="eyebrow">Fig. 4 — Language-neutral</p>
            <h2 id="languages-title">Write the catalog in <em>your</em> language.</h2>
            <p class="lede">
              Use a catalog library for TypeScript, Python, Go or Rust, or a Pkl module. Every library writes the same catalog, in one canonical form, and <code>acid-cat check</code> tests it.
            </p>
          </div>
          <NixieTubes languages={languages} />
        </div>
      </section>

    </main>

    <footer class="footer">
      <span>AcidCat · MIT license · Experimental: the specification is a draft, and the packages are 0.x.</span>
      <span class="footer-links">
        <a href="/docs/">Docs</a>
        <a href={`${repository}/blob/main/spec/README.md`}>Specification</a>
        <a href={repository}>GitHub</a>
      </span>
    </footer>

    <script>
      for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
        button.addEventListener("click", () => {
          const text = button.dataset["copy"] ?? "";
          navigator.clipboard.writeText(text).then(
            () => {
              button.textContent = "Copied";
              window.setTimeout(() => (button.textContent = "Copy"), 1600);
            },
            () => {
              button.textContent = "Select";
            },
          );
        });
      }

      for (const card of document.querySelectorAll<HTMLElement>("[data-feature]")) {
        card.addEventListener("pointermove", (event) => {
          const box = card.getBoundingClientRect();
          card.style.setProperty("--mx", `${event.clientX - box.left}px`);
          card.style.setProperty("--my", `${event.clientY - box.top}px`);
        });
        card.addEventListener("click", () => card.classList.toggle("is-open"));
        card.addEventListener("keydown", (event) => {
          if (event.key !== "Enter" && event.key !== " ") return;
          event.preventDefault();
          card.classList.toggle("is-open");
        });
      }

      const reveal = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-visible");
            reveal.unobserve(entry.target);
          }
        },
        { threshold: 0.15 },
      );
      for (const element of document.querySelectorAll(".section-head, .part, .feature, .machine:not([drawable]), .blueprint, .spec-sheet")) {
        element.classList.add("will-reveal");
        reveal.observe(element);
      }
    </script>
  </body>
</html>
