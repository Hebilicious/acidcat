---
import "../styles/tokens.css";
import "../styles/home.css";
import LivingPlate from "../components/LivingPlate.astro";
import Blueprint from "../components/Blueprint.astro";
import CoreScreens from "../components/CoreScreens.astro";
import Surfaces from "../components/Surfaces.astro";
import Mark from "../components/Mark.astro";
import Schematic from "../components/Schematic.astro";

const repository = "https://github.com/Hebilicious/acidcat";
const title = "AcidCat — One catalog. Every surface.";
const description = "Describe what your application can do once. Serve it as a CLI, an MCP server, an HTTP API and typed client code.";



---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0e14" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <a class="brand" href="/" aria-label="AcidCat home">
        <Mark size={34} />
        <span>AcidCat</span>
      </a>
      <nav aria-label="Main">
        <a href="/docs/">Docs</a>
        <a href={`${repository}/blob/main/spec/README.md`}>Spec</a>
        <a href={`${repository}/blob/main/packages/README.md`}>Packages</a>
        <a class="nav-github" href={repository}>GitHub</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-stage">
          <LivingPlate />
        </div>
        <div class="hero-copy">
          <p class="eyebrow reveal">An open specification · 0.1 draft</p>
          <h1 id="hero-title" class="reveal">AcidCat</h1>
          <div class="ornament reveal" aria-hidden="true">
            <span></span>
            <svg viewBox="0 0 24 24" width="22" height="22"><circle cx="12" cy="12" r="5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M12 1v5M12 18v5M1 12h5M18 12h5M4.2 4.2l3.5 3.5M16.3 16.3l3.5 3.5M4.2 19.8l3.5-3.5M16.3 7.7l3.5-3.5" stroke="currentColor" stroke-width="2" /></svg>
            <span></span>
          </div>
          <p class="hero-lede reveal">
            AcidCat is an open specification. Describe what your application can do once, in a <strong>catalog</strong>. Each operation then becomes a <strong>command line</strong>, a tool in an <strong>MCP server</strong> for AI agents, an <strong>HTTP API</strong> and <strong>typed code</strong>, with the same input and the same failures everywhere.
          </p>
          <div class="actions reveal">
            <a class="button button-acid" href="/docs/">Get started</a>
            <a class="button button-brass" href={`${repository}/blob/main/spec/README.md`}>Read the spec</a>
          </div>
        </div>
      </section>

      <Schematic />

      <section class="flow" aria-labelledby="flow-title">
        <div class="flow-inner">
          <header class="section-head">
            <p class="eyebrow">Fig. 2 — How the parts fit</p>
            <h2 id="flow-title">Spec, catalog, <em>runtime, verify</em></h2>
            <p class="lede">The specification defines the catalog and the bindings. A catalog lists the capabilities of one application. A core runs them, and <code>acid-cat conform</code> tests the result from outside.</p>
          </header>
          <Blueprint />
        </div>
      </section>

      <Surfaces />

      <CoreScreens />

    </main>

    <footer class="footer">
      <span>AcidCat · MIT license · Experimental: the specification is a draft, and the packages are 0.x.</span>
      <span class="footer-links">
        <a href="/docs/">Docs</a>
        <a href={`${repository}/blob/main/spec/README.md`}>Specification</a>
        <a href={repository}>GitHub</a>
      </span>
    </footer>

    <script>
      const reveal = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-visible");
            reveal.unobserve(entry.target);
          }
        },
        { threshold: 0.15 },
      );
      for (const element of document.querySelectorAll(".section-head, .surface, .machine:not([drawable]), .blueprint, .spec-sheet")) {
        element.classList.add("will-reveal");
        reveal.observe(element);
      }
    </script>
  </body>
</html>
