---
import "../styles/tokens.css";
import "../styles/home.css";
import LivingPlate from "../components/LivingPlate.astro";
import Blueprint from "../components/Blueprint.astro";
import CoreScreens from "../components/CoreScreens.astro";
import Surfaces from "../components/Surfaces.astro";
import Mark from "../components/Mark.astro";
import Schematic from "../components/Schematic.astro";

const repository = "https://github.com/Hebilicious/acidcat";
const title = "AcidCat — One catalog. Every surface.";
const description = "Describe what your application can do once. Serve it as a CLI, an MCP server, an HTTP API and typed client code.";



---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0e14" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <a class="brand" href="/" aria-label="AcidCat home">
        <Mark size={34} />
        <span>AcidCat</span>
      </a>
      <nav aria-label="Main">
        <a href="/docs/"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z" /><path d="M4 20.5A2.5 2.5 0 0 0 6.5 23H20v-5" /><path d="M9 8h7M9 12h5" /></svg>Docs</a>
        <a href={`${repository}/blob/main/spec/README.md`}><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" /><path d="M9 13h6M9 17h4" /></svg>Spec</a>
        <a href={`${repository}/blob/main/packages/README.md`}><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5 3.5 7v10l8.5 4.5 8.5-4.5V7z" /><path d="M3.5 7 12 11.5 20.5 7M12 11.5v10" /></svg>Packages</a>
        <a class="nav-github" href={repository}><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" /></svg>GitHub</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-stage">
          <LivingPlate />
        </div>
        <div class="hero-copy">
          <p class="eyebrow reveal">An open specification · 0.1 draft</p>
          <h1 id="hero-title" class="reveal">AcidCat</h1>
          <p class="hero-expansion reveal"><b>A</b>pplication <b>C</b>apability <b>Id</b>entification <b>Cat</b>alog</p>
          <p class="hero-lede reveal">Describe what your application can do once. Serve it as a command line, an MCP server, an HTTP API and typed code.</p>
          <div class="actions reveal">
            <a class="button button-acid" href="/docs/"><span>Get started</span><i class="shine" aria-hidden="true"></i></a>
            <a class="button button-brass" href={`${repository}/blob/main/spec/README.md`}><span>Read the spec</span><i class="shine" aria-hidden="true"></i></a>
          </div>
        </div>
      </section>

      <div class="blueprint-zone">
      <Schematic />

      <section class="flow" aria-labelledby="flow-title">
        <div class="flow-inner">
          <header class="section-head">
            <p class="eyebrow">Fig. 2 — How the parts fit</p>
            <h2 id="flow-title">Spec, catalog, <em>runtime, verify</em></h2>
            <p class="lede">The specification defines the catalog and the bindings. A catalog lists the capabilities of one application. A core runs them, and <code>acid-cat conform</code> tests the result from outside.</p>
          </header>
          <Blueprint />
        </div>
      </section>
      </div>

      <Surfaces />

      <CoreScreens />

    </main>

    <footer class="footer">
      <div class="footer-rail" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
      <div class="footer-inner">
        <div class="footer-brand">
          <Mark size={56} />
          <p class="footer-name">AcidCat</p>
          <p class="footer-expansion"><b>A</b>pplication <b>C</b>apability <b>Id</b>entification <b>Cat</b>alog</p>
          <p class="footer-status"><span class="footer-lamp" aria-hidden="true"></span>Specification 0.1, draft. The packages are 0.x: pin exact versions.</p>
        </div>
        <nav class="footer-columns" aria-label="Footer">
          <div>
            <p class="footer-heading">Specification</p>
            <ul>
              <li><a href={`${repository}/blob/main/spec/catalog.md`}>Catalog</a></li>
              <li><a href={`${repository}/blob/main/spec/invocation.md`}>Invocation</a></li>
              <li><a href={`${repository}/blob/main/spec/events.md`}>Events</a></li>
              <li><a href={`${repository}/blob/main/spec/bindings/README.md`}>Bindings</a></li>
              <li><a href={`${repository}/blob/main/spec/extensions/README.md`}>Extensions</a></li>
              <li><a href={`${repository}/blob/main/spec/conformance.md`}>Conformance</a></li>
            </ul>
          </div>
          <div>
            <p class="footer-heading">Build</p>
            <ul>
              <li><a href="https://www.npmjs.com/package/@acid-cat/cli">The acid-cat command</a></li>
              <li><a href={`${repository}/tree/main/examples/aircon`}>Air conditioner example</a></li>
              <li><a href={`${repository}/blob/main/skills/acid-cat/SKILL.md`}>Agent skill</a></li>
            </ul>
          </div>
          <div>
            <p class="footer-heading">Project</p>
            <ul>
              <li><a href={`${repository}/releases`}>Releases</a></li>
              <li><a href={`${repository}/issues`}>Issues</a></li>
              <li><a href={`${repository}/blob/main/LICENSE`}>MIT license</a></li>
            </ul>
          </div>
        </nav>
      </div>
      <p class="footer-watermark" aria-hidden="true">AcidCat</p>
    </footer>

    <script>
      const reveal = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-visible");
            reveal.unobserve(entry.target);
          }
        },
        { threshold: 0.15 },
      );
      for (const element of document.querySelectorAll(".section-head, .surface, .machine:not([drawable]), .blueprint, .spec-sheet")) {
        element.classList.add("will-reveal");
        reveal.observe(element);
      }
    </script>
  </body>
</html>
