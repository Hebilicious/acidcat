---
import argonMedium from "../../../.fonts/monaspace-argon-500-core.woff2?url";
import argon from "../../../.fonts/monaspace-argon-400-core.woff2?url";
import kryptonMedium from "../../../.fonts/monaspace-krypton-500-core.woff2?url";
import krypton from "../../../.fonts/monaspace-krypton-400-core.woff2?url";
import neonMedium from "../../../.fonts/monaspace-neon-500-core.woff2?url";
import neon from "../../../.fonts/monaspace-neon-400-core.woff2?url";
import radonMedium from "../../../.fonts/monaspace-radon-500-core.woff2?url";
import xenonBold from "../../../.fonts/monaspace-xenon-700-core.woff2?url";
import xenon from "../../../.fonts/monaspace-xenon-400-core.woff2?url";

interface Props {
  readonly page: "home" | "docs";
}

const used = {
  home: [xenon, xenonBold, radonMedium, argon, krypton, kryptonMedium, neon],
  docs: [xenon, xenonBold, argon, argonMedium, krypton, kryptonMedium, neon, neonMedium],
};
const fonts = used[Astro.props.page];
---

{fonts.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
