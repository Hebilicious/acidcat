---
import Mark from "../Mark.astro";

const repository = "https://github.com/Hebilicious/acidcat";
const path = Astro.url.pathname;
const links = [
  { href: "/docs/", label: "Docs", icon: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z" /><path d="M4 20.5A2.5 2.5 0 0 0 6.5 23H20v-5" /><path d="M9 8h7M9 12h5" />' },
  { href: "/spec/", label: "Spec", icon: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" /><path d="M9 13h6M9 17h4" />' },
  { href: "/packages/", label: "Packages", icon: '<path d="M12 2.5 3.5 7v10l8.5 4.5 8.5-4.5V7z" /><path d="M3.5 7 12 11.5 20.5 7M12 11.5v10" />' },
  { href: repository, label: "GitHub", icon: '<path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />' },
];
const current = (href: string) => href.startsWith("/") && path.startsWith(href);
---

<div class="site-nav">
  <a class="site-brand" href="/" aria-label="AcidCat home">
    <Mark idSuffix="header" size={34} />
    <span>AcidCat</span>
  </a>
  <div class="site-search"><slot name="search" /></div>
  <nav class="site-links" aria-label="Site">
    {links.map((link) => (
      <a href={link.href} aria-label={link.label} aria-current={current(link.href) ? "page" : undefined} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}>
        <svg class="site-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={link.icon} />
        <span class="site-label">{link.label}</span>
      </a>
    ))}
  </nav>
</div>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--spacing_fluid-space-m);
    width: 100%;
    height: 100%;
  }
  .site-brand {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--spacing_fluid-space-xs);
    color: var(--palette-cream-100);
    text-decoration: none;
    font-family: var(--font-family-display);
    font-size: var(--typography_fluid-display-m);
    font-weight: var(--typography-weight-display-bold);
    letter-spacing: -0.01em;
  }
  .site-search {
    flex: 1;
    display: flex;
    justify-content: center;
    min-width: 0;
  }
  .site-search:empty {
    visibility: hidden;
  }
  .site-links {
    display: flex;
    flex: none;
    gap: var(--spacing_fluid-space-s-m);
    font-family: var(--font-family-sans);
    font-size: var(--typography_fluid-text-s);
  }
  .site-links a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--spacing_fluid-space-2xs);
    padding-block: var(--spacing_fluid-space-3xs);
    color: var(--palette-cream-400);
    text-decoration: none;
    transition: color 0.2s;
  }
  .site-links a:hover {
    color: var(--palette-acid-400);
  }
  .site-links a[aria-current="page"] {
    color: var(--palette-cream-100);
  }
  .site-links a[aria-current="page"]::after {
    content: "";
    position: absolute;
    inset: auto 0 calc(-1 * var(--spacing_fluid-space-2xs));
    height: 2px;
    border-radius: 1px;
    background: var(--palette-acid-400);
    box-shadow: 0 0 10px var(--palette-acid-400);
  }
  .site-icon {
    width: 1em;
    height: 1em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.75;
  }
  .site-links a:hover .site-icon,
  .site-links a[aria-current="page"] .site-icon {
    opacity: 1;
  }
  @media (max-width: 720px) {
    .site-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .site-icon {
      width: 1.35em;
      height: 1.35em;
    }
    .site-links {
      gap: var(--spacing_fluid-space-s);
    }
    .site-brand span {
      display: none;
    }
  }
</style>
