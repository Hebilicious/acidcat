---
import { highlight } from "../lib/snippets.ts";

const repository = "https://github.com/Hebilicious/acidcat/blob/main";

const surfaces = [
  {
    id: "cli",
    name: "Command line",
    who: "People and scripts",
    text: "The words of the id become the command, and each input property becomes a flag. The catalog can give short aliases. In a pipe, the program writes each result as one line of JSON.",
    language: "shellscript",
    code: "$ home aircon power set --on\n$ home --on\n$ home list",
    spec: "spec/bindings/cli.md",
  },
  {
    id: "mcp",
    name: "MCP server",
    who: "AI agents",
    text: "tools/list gives one tool for each available capability. The name of the tool is the id. destructive and idempotent become hints, so an agent knows when to ask first.",
    language: "json",
    code: '{\n  "name": "aircon.power.set",\n  "description": "Turn the unit on or off.",\n  "annotations": { "destructiveHint": true, "idempotentHint": true }\n}',
    spec: "spec/bindings/mcp.md",
  },
  {
    id: "webmcp",
    name: "WebMCP",
    who: "Agents in the browser",
    text: "The page registers a tool for each available capability with registerTool. A browser agent calls it with the session of the signed-in user.",
    language: "json",
    code: '{\n  "name": "aircon.power.set",\n  "inputSchema": {\n    "type": "object",\n    "properties": { "on": { "type": "boolean" } },\n    "required": ["on"]\n  }\n}',
    spec: "spec/bindings/webmcp.md",
  },
  {
    id: "http",
    name: "HTTP API",
    who: "Other programs",
    text: "A POST to /capabilities/{id} with the input as the body gives the outcome. A POST to /events/{id} streams the occurrences as server-sent events.",
    language: "http",
    code: 'POST /capabilities/aircon.power.set\nContent-Type: application/json\n\n{ "on": true }',
    spec: "spec/bindings/http.md",
  },
  {
    id: "ts",
    name: "Programmatic access",
    who: "Your own code",
    text: "A session gives a handle for each capability. execute returns a result: the value, or a failure with its tag. An AbortSignal cancels the call.",
    language: "typescript",
    code: 'const result = await handle.execute({ on: true });\nif (!result.ok && result.error._tag === "Offline") {\n  showOffline();\n}',
    spec: "spec/bindings/typescript.md",
  },
].map((surface) => ({ ...surface, html: highlight(surface.code, surface.language) }));
---

<section class="surfaces" aria-labelledby="surfaces-title">
  <header class="section-head">
    <p class="eyebrow">Fig. 3 — Surfaces</p>
    <h2 id="surfaces-title">The five surfaces</h2>
    <p class="lede">Each surface exposes <code>aircon.power.set</code> with the same input and the same failures.</p>
  </header>
  <div class="surface-tabs" role="tablist" aria-labelledby="surfaces-title" hidden>
    {surfaces.map(({ id, name }, index) => (
      <button type="button" role="tab" id={`tab-${id}`} aria-controls={`surface-${id}`} aria-selected={index === 0} data-surface={id}>
        <span class="gauge" aria-hidden="true"><span class="fluid"><i></i><i></i></span></span>
        {name}
      </button>
    ))}
  </div>
  {surfaces.map((surface) => (
    <article class="surface-panel" id={`surface-${surface.id}`} aria-labelledby={`name-${surface.id}`}>
      <div class="specimen"><img src={`/surfaces/${surface.id}.webp`} alt="" width="720" height="720" loading="lazy" /></div>
      <span class="column-gauge" aria-hidden="true"><span class="column-fluid"><i></i><i></i><i></i><i></i></span></span>
      <div class="surface-copy">
        <p class="audience">{surface.who}</p>
        <h3 id={`name-${surface.id}`}>{surface.name}</h3>
        <p class="description">{surface.text}</p>
        <div class="sample" set:html={surface.html} />
        <a href={`${repository}/${surface.spec}`}>Read the binding <span aria-hidden="true">↗</span></a>
      </div>
    </article>
  ))}
</section>

<style>
  .surfaces {
    width: min(var(--layout-width-content), 100%);
    margin-inline: auto;
    padding: var(--spacing_fluid-space-3xl-4xl) var(--layout-gutter-inline) 0;
  }
  .section-head { margin-bottom: var(--spacing_fluid-space-xl); }
  .surface-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    padding: 1px;
    background: var(--palette-brass-800);
  }
  button {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing_fluid-space-xs);
    padding: var(--spacing_fluid-space-xs) var(--spacing_fluid-space-s);
    border: 0;
    background: var(--palette-ink-900);
    color: var(--palette-cream-400);
    font: inherit;
    font-family: var(--font-family-label);
    font-size: var(--typography_fluid-text-s);
    cursor: pointer;
  }
  button[aria-selected="true"] {
    color: var(--palette-cream-100);
    background: linear-gradient(var(--palette-ink-800), var(--palette-brass-950));
    box-shadow: inset 0 -2px var(--palette-brass-400);
  }
  button:focus-visible { outline: 2px solid var(--palette-cyan-400); outline-offset: -3px; }
  .gauge {
    position: relative;
    flex: none;
    width: 12px;
    height: 2.4rem;
    overflow: hidden;
    border: 1px solid var(--palette-brass-600);
    border-block: 3px solid var(--palette-brass-400);
    border-radius: var(--radius-size-s);
    background: linear-gradient(90deg, var(--palette-ink-950), var(--palette-ink-600), var(--palette-ink-925));
  }
  .fluid {
    position: absolute;
    inset: auto 1px 1px;
    height: 16%;
    overflow: hidden;
    border-radius: inherit;
    background: linear-gradient(var(--palette-acid-400), var(--palette-acid-700));
    transition: height 700ms ease;
  }
  button[aria-selected="true"] .fluid { height: 80%; }
  button:hover .fluid { height: 50%; }
  button[aria-selected="true"]:hover .fluid { height: 96%; }
  .fluid i {
    position: absolute;
    bottom: 0;
    left: 1px;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--palette-acid-200);
    opacity: 0;
  }
  button:is(:hover, [aria-selected="true"]) i { animation: bubble 1.5s ease-in infinite; }
  button:is(:hover, [aria-selected="true"]) i + i { left: 3px; animation-delay: -0.7s; }
  @keyframes bubble {
    20% { opacity: 1; }
    to { transform: translateY(-1.6rem); opacity: 0; }
  }
  .surface-panel {
    display: grid;
    grid-template-columns: minmax(0, 4fr) auto minmax(0, 6fr);
    border: 1px solid var(--palette-brass-800);
    background: var(--palette-ink-925);
  }
  .surface-panel[hidden], .surface-tabs[hidden] { display: none; }
  .specimen {
    position: relative;
    min-height: 100%;
    overflow: hidden;
    background: var(--palette-ink-950);
  }
  .specimen::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 55%, transparent 55%, var(--palette-ink-925));
    pointer-events: none;
  }
  .specimen img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .column-gauge {
    position: relative;
    width: 22px;
    margin: var(--spacing_fluid-space-l) 0 var(--spacing_fluid-space-l) var(--spacing_fluid-space-m);
    overflow: hidden;
    border: 1px solid color-mix(in oklch, var(--palette-cream-100) 30%, transparent);
    border-block: 6px solid var(--palette-brass-400);
    border-radius: var(--radius-size-m);
    background: linear-gradient(90deg, var(--palette-ink-950), var(--palette-ink-700) 45%, var(--palette-ink-950));
    box-shadow: inset 0 0 8px var(--palette-neutral-black);
  }
  .column-fluid {
    position: absolute;
    inset: auto 3px 3px;
    height: 86%;
    border-radius: var(--radius-size-s);
    background: linear-gradient(var(--palette-acid-400), var(--palette-acid-700));
    box-shadow: 0 0 14px var(--palette-acid-400);
    animation: column-fill 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) both, column-wave 4s ease-in-out 1.1s infinite;
  }
  .column-fluid i {
    position: absolute;
    bottom: 4px;
    left: 4px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--palette-acid-200);
    opacity: 0;
    animation: column-bubble 1.8s ease-in infinite;
  }
  .column-fluid i:nth-child(2) { left: 8px; animation-delay: -0.5s; }
  .column-fluid i:nth-child(3) { left: 5px; animation-delay: -1s; }
  .column-fluid i:nth-child(4) { left: 9px; animation-delay: -1.4s; }
  @keyframes column-fill { from { height: 6%; } }
  @keyframes column-wave { 50% { height: 78%; } }
  @keyframes column-bubble {
    20% { opacity: 1; }
    to { transform: translateY(-14rem); opacity: 0; }
  }
  .surface-copy {
    align-self: center;
    min-width: 0;
    padding: var(--spacing_fluid-space-l-xl);
  }
  .audience, .surface-copy a {
    font-family: var(--font-family-label);
    font-size: var(--typography_fluid-text-xs);
    letter-spacing: var(--font-tracking-label);
    text-transform: uppercase;
  }
  .audience { margin: 0 0 var(--spacing_fluid-space-xs); color: var(--palette-cyan-400); }
  h3 { margin: 0; font-family: var(--font-family-display); font-size: var(--typography_fluid-display-xl); line-height: 1.12; }
  .description { margin: var(--spacing_fluid-space-m) 0; color: var(--palette-cream-400); }
  .sample {
    padding: var(--spacing_fluid-space-s-m);
    border-inline-start: 2px solid var(--palette-brass-600);
    background: var(--palette-ink-950);
    overflow-x: auto;
    font-size: var(--typography_fluid-text-s);
    line-height: 1.55;
  }
  .surface-copy a { display: inline-block; margin-top: var(--spacing_fluid-space-m); color: var(--palette-brass-300); text-underline-offset: 0.3em; }
  @media (max-width: 720px) {
    button { justify-content: start; }
    .surface-panel { grid-template-columns: minmax(0, 1fr); }
    .specimen { aspect-ratio: 4 / 3; min-height: 0; }
    .column-gauge { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fluid { transition: none; }
    button:is(:hover, [aria-selected="true"]) i, .column-fluid, .column-fluid i { animation: none; }
  }
</style>

<script>
  const rail = document.querySelector<HTMLElement>(".surface-tabs");
  if (rail) {
    const tabs = Array.from(rail.querySelectorAll("button"));
    const select = (active: HTMLButtonElement) => {
      for (const tab of tabs) {
        const selected = tab === active;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute("aria-controls") ?? "");
        if (panel) {
          panel.hidden = !selected;
          panel.tabIndex = 0;
          panel.setAttribute("role", "tabpanel");
          panel.setAttribute("aria-labelledby", tab.id);
        }
      }
    };
    const announce = (detail: string | null) => document.dispatchEvent(new CustomEvent("acidcat:surface", { detail }));
    for (const [index, tab] of tabs.entries()) {
      const signal = () => announce(tab.dataset["surface"] ?? null);
      tab.addEventListener("pointerenter", signal);
      tab.addEventListener("pointerleave", () => announce(null));
      tab.addEventListener("focus", signal);
      tab.addEventListener("blur", () => announce(null));
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (event) => {
        const targets: Record<string, number> = {
          ArrowRight: (index + 1) % tabs.length,
          ArrowLeft: (index + tabs.length - 1) % tabs.length,
          Home: 0,
          End: tabs.length - 1,
        };
        const targetIndex = targets[event.key];
        const target = targetIndex === undefined ? undefined : tabs[targetIndex];
        if (target) {
          event.preventDefault();
          select(target);
          target.focus();
        }
      });
    }
    if (tabs[0]) select(tabs[0]);
    rail.hidden = false;
  }
</script>
