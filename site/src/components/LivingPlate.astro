---
const alt = "A mechanical brass cat with glowing acid-green eyes sits on a brass pedestal in a dark workshop of the future, with holographic rings around it.";
---

<div class="plate" data-plate>
  <img
    class="plate-still"
    src="/hero/plate.webp"
    srcset="/hero/plate.webp 1672w, /hero/plate@2x.webp 3344w"
    sizes="100vw"
    width="1672"
    height="941"
    alt={alt}
    fetchpriority="high"
    decoding="async"
  />
  <canvas class="plate-canvas" aria-hidden="true"></canvas>
</div>

<style>
  .plate {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--palette-ink-950);
  }
  .plate-still,
  .plate-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .plate-still {
    object-fit: cover;
    object-position: var(--plate-position, 60% 50%);
  }
  .plate-canvas {
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .plate.is-live .plate-canvas {
    opacity: 1;
  }
</style>

<script>
  import { createPlate, framingSpan } from "../lib/plate-renderer.ts";
  import type { PlateFraming } from "../lib/plate-renderer.ts";

  const art = { width: 2400, height: 941, pad: 728 };
  const catX = (art.pad + 0.555 * 1672) / art.width;

  const framing = (): PlateFraming => {
    const width = window.innerWidth;
    const targetX = width >= 1200 ? 0.76 : width >= 960 ? 0.7 : 0.5;
    return { aspect: art.width / art.height, focusX: catX, targetX, zoom: 1 };
  };

  for (const root of document.querySelectorAll<HTMLElement>("[data-plate]")) {
    const canvas = root.querySelector("canvas");
    const still = root.querySelector("img");
    if (canvas === null || still === null) continue;

    const place = () => {
      const { span, center } = framingSpan(root.clientWidth, root.clientHeight, framing());
      const x = span[0] < 1 ? (center[0] - span[0] / 2) / (1 - span[0]) : 0.5;
      const y = span[1] < 1 ? (center[1] - span[1] / 2) / (1 - span[1]) : 0.5;
      root.style.setProperty("--plate-position", `${(x * 100).toFixed(2)}% ${(y * 100).toFixed(2)}%`);
    };
    place();
    window.addEventListener("resize", place, { passive: true });

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (reduced.matches) continue;

    const large = root.clientWidth * Math.min(window.devicePixelRatio, 1.75) > 1900;
    createPlate(canvas, { artPad: art.pad, plate: large ? "/hero/plate@2x.webp" : "/hero/plate.webp", clean: "/hero/clean.webp", data: "/hero/data.png" }, framing).then(
      (plate) => {
        plate.render({ reveal: 0 });
        root.classList.add("is-live");
        root.dataset["gpu"] = plate.backend;
        if (plate.software) return;
        let visible = true;
        const sync = () => (visible && document.visibilityState === "visible" ? plate.start() : plate.stop());
        new IntersectionObserver(([entry]) => {
          visible = entry?.isIntersecting ?? false;
          sync();
        }).observe(root);
        document.addEventListener("visibilitychange", sync);
        document.addEventListener("acidcat:surface", (event) => {
          plate.setActive(event instanceof CustomEvent && typeof event.detail === "string");
        });
      },
      () => {
        canvas.remove();
      },
    );
  }
</script>
