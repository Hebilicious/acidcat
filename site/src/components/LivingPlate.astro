---
import phone840 from "../assets/hero/phone-840.avif?url";
import phone from "../assets/hero/phone.avif?url";
import phone2x from "../assets/hero/phone@2x.avif?url";
import plateAvif from "../assets/hero/plate.avif?url";
import plate2xAvif from "../assets/hero/plate@2x.avif?url";
import plateWebp from "../assets/hero/plate.webp?url";
import plate2xWebp from "../assets/hero/plate@2x.webp?url";
import { art, phoneCrop, phoneMedia } from "../lib/plate-crop.ts";

const alt = "A mechanical brass cat with glowing acid-green eyes sits on a brass pedestal in a dark workshop of the future, with holographic rings around it.";
const phoneWidth = (scale: number) => Math.round(phoneCrop.width * scale);
// At 960px and below the hero is 1.02 times as tall as it is wide, and the plate covers it by its height.
const phoneSizes = `${Math.ceil(102 * (phoneCrop.width / art.height))}vw`;
---

<div class="plate" data-plate>
  <picture>
    <source
      type="image/avif"
      media={phoneMedia}
      srcset={`${phone840} 840w, ${phone} ${phoneWidth(1)}w, ${phone2x} ${phoneWidth(2)}w`}
      sizes={phoneSizes}
      data-phone
    />
    <source type="image/avif" srcset={`${plateAvif} 1672w, ${plate2xAvif} 3344w`} sizes="100vw" />
    <img
      class="plate-still"
      src={plateWebp}
      srcset={`${plateWebp} 1672w, ${plate2xWebp} 3344w`}
      sizes="100vw"
      width="1672"
      height="941"
      alt={alt}
      fetchpriority="high"
    />
  </picture>
  <canvas class="plate-canvas" aria-hidden="true"></canvas>
</div>

<style>
  .plate {
    --plate-position: 60% 50%;
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--palette-ink-950);
  }
  @media (max-width: 960px) {
    .plate {
      --plate-position: 50% 50%;
    }
  }
  .plate-still,
  .plate-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .plate-still {
    object-fit: cover;
    object-position: var(--plate-position);
  }
  .plate-canvas {
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .plate.is-live .plate-canvas {
    opacity: 1;
  }
</style>

<script>
  import cleanAvif from "../assets/hero/clean.avif?url";
  import cleanWebp from "../assets/hero/clean.webp?url";
  import data from "../assets/hero/data.webp?url";
  import { art, phoneCrop, phoneMedia } from "../lib/plate-crop.ts";
  import { createPlate, framingSpan } from "../lib/plate-renderer.ts";
  import type { PlateFraming } from "../lib/plate-renderer.ts";

  const catX = (art.pad + 0.555 * 1672) / art.width;
  const wide = window.matchMedia("(min-width: 1200px)");
  const phone = window.matchMedia(phoneMedia);
  const fullRect = [0, 1] as const;
  const phoneRect = [phoneCrop.x / art.width, phoneCrop.width / art.width] as const;

  const framing = (): PlateFraming => {
    const targetX = wide.matches ? 0.76 : phone.matches ? 0.5 : 0.7;
    return { aspect: art.width / art.height, focusX: catX, targetX, zoom: 1 };
  };

  for (const root of document.querySelectorAll<HTMLElement>("[data-plate]")) {
    const canvas = root.querySelector("canvas");
    const still = root.querySelector("img");
    const phoneSource = root.querySelector<HTMLSourceElement>("source[data-phone]");
    if (canvas === null || still === null || phoneSource === null) continue;

    const phonePlates = new Set(phoneSource.srcset.split(",").map((candidate) => new URL(candidate.trim().split(" ")[0] ?? "", document.baseURI).href));
    const plateRect = () => (phonePlates.has(still.currentSrc) ? phoneRect : fullRect);

    let size = { width: 0, height: 0 };
    const place = () => {
      if (size.width === 0 || size.height === 0) return;
      const { span, center } = framingSpan(size.width, size.height, framing());
      const [start, width] = plateRect();
      const spanX = span[0] / width;
      const centerX = (center[0] - start) / width;
      const x = spanX < 1 ? Math.min(1, Math.max(0, (centerX - spanX / 2) / (1 - spanX))) : 0.5;
      const y = span[1] < 1 ? (center[1] - span[1] / 2) / (1 - span[1]) : 0.5;
      root.style.setProperty("--plate-position", `${(x * 100).toFixed(2)}% ${(y * 100).toFixed(2)}%`);
    };
    // The observer gives the size after layout, so reading it forces no layout.
    new ResizeObserver(([entry]) => {
      if (entry === undefined) return;
      size = { width: entry.contentRect.width, height: entry.contentRect.height };
      place();
    }).observe(root);
    still.addEventListener("load", place);

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (reduced.matches) continue;

    let shown = "";
    const sources = () => {
      shown = still.currentSrc;
      const avif = shown.endsWith(".avif");
      return { artPad: art.pad, plate: shown, plateRect: plateRect(), clean: avif ? cleanAvif : cleanWebp, data };
    };
    still.decode().catch(() => undefined).then(() => createPlate(canvas, sources(), framing)).then(
      (plate) => {
        if (plate === undefined) {
          canvas.remove();
          return;
        }
        root.classList.add("is-live");
        root.dataset["gpu"] = plate.backend;
        let visible = true;
        const sync = () => (visible && document.visibilityState === "visible" ? plate.start() : plate.stop());
        // A resize across 960px gives the still image a plate with other columns. The canvas draws from the same file.
        let swap = Promise.resolve();
        const follow = () => {
          const source = still.currentSrc;
          const rect = plateRect();
          swap = swap.then(async () => {
            if (source === shown || !still.complete) return;
            shown = source;
            await plate.setPlate(source, rect);
          });
          swap.catch(() => {
            plate.stop();
            canvas.remove();
            root.classList.remove("is-live");
          });
        };
        still.addEventListener("load", follow);
        follow();
        new IntersectionObserver(([entry]) => {
          visible = entry?.isIntersecting ?? false;
          sync();
        }).observe(root);
        document.addEventListener("visibilitychange", sync);
        document.addEventListener("acidcat:surface", (event) => {
          plate.setActive(event instanceof CustomEvent && typeof event.detail === "string");
        });
      },
      () => {
        canvas.remove();
      },
    );
  }
</script>
