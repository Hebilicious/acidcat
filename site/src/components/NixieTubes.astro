---
interface Props {
  languages: readonly { code: string; name: string }[];
}
const { languages } = Astro.props;
---
<nixie-tubes style={`--count:${languages.length}`}>
  <canvas aria-hidden="true"></canvas>
  <ul role="list">
    {languages.map(({code, name}) => (
      <li>
        <span class="envelope" aria-hidden="true"><span class="filament">{code}</span></span>
        <span class="socket" aria-hidden="true"></span>
        <span class="label">{name}</span>
      </li>
    ))}
  </ul>
</nixie-tubes>
<script>
  import { observeTubes } from "../lib/nixie-scene";
  customElements.define("nixie-tubes", class extends HTMLElement {
    private stop: (() => void) | undefined;
    connectedCallback() {
      this.stop = observeTubes(this);
    }
    disconnectedCallback() {
      this.stop?.();
    }
  });
</script>
<style>
  nixie-tubes {
    position: relative;
    display: block;
    width: min(100%, 40rem);
    min-width: 0;
    margin-inline: auto;
    container-type: inline-size;
  }
  canvas {
    position: absolute;
    inset: 0 0 auto;
    width: 100%;
    aspect-ratio: var(--count) / 1.95;
    visibility: hidden;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(var(--count), minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li { min-width: 0; display: flex; align-items: center; flex-direction: column; }
  .envelope {
    display: grid;
    place-items: center;
    position: relative;
    margin-top: 12%;
    width: 76%;
    aspect-ratio: 0.49;
    border: 1px solid color-mix(in oklch, var(--palette-cream-100) 35%, transparent);
    border-radius: 50% 50% 10% 10% / 26% 26% 5% 5%;
    background: linear-gradient(90deg, color-mix(in oklch, var(--palette-neutral-white) 8%, transparent), transparent 30% 70%, color-mix(in oklch, var(--palette-neutral-white) 5%, transparent)), radial-gradient(ellipse, color-mix(in oklch, var(--palette-nixie-400) 22%, transparent), color-mix(in oklch, var(--palette-neutral-black) 60%, transparent) 70%);
  }
  .envelope::before {
    content: ""; position: absolute; inset: 18% 16%;
    background: repeating-linear-gradient(0deg, color-mix(in oklch, var(--palette-nixie-400) 12%, transparent) 0 1px, transparent 1px 6px);
  }
  .filament {
    font: 500 clamp(1rem, 5cqw, 2.3rem) var(--font-display);
    color: var(--palette-nixie-200);
    text-shadow: 0 0 4px var(--palette-nixie-400), 0 0 14px var(--palette-nixie-400);
  }
  .socket {
    width: 88%; height: 3.5cqw; border-radius: 4px;
    background: linear-gradient(90deg, var(--palette-brass-800), var(--palette-brass-200) 40%, var(--palette-brass-500) 70%, var(--palette-brass-800));
  }
  .label {
    margin-top: auto; padding-top: 0.4rem;
    font: 500 clamp(0.55rem, 2cqw, 0.73rem) var(--font-mono);
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--palette-cream-400);
  }
  [data-lit] canvas { visibility: visible; }
  [data-lit] ul { padding-top: calc(195% / var(--count)); }
  [data-lit] .envelope, [data-lit] .socket { display: none; }
</style>
