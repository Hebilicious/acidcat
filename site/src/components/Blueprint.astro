---
import Exploded from "./Exploded.astro";

const specs = [
  ["Specification", "0.1 draft"],
  ["Schemas", "JSON Schema 2020-12"],
  ["MCP revision", "2026-07-28"],
  ["Bindings", "TypeScript · WebMCP · MCP · CLI · HTTP"],
  ["Catalog in", "TypeScript · Python · Go · Rust · Pkl"],
  ["Cores", "Effect · TypeScript · Rust"],
];
---

<div class="blueprint-row">
  <div class="blueprint">
    <p class="blueprint-label">Fig. 1a — Exploded view</p>
    <Exploded />
  </div>
  <div class="spec-sheet">
  <p class="spec-title">Key specifications</p>
  <dl>
    {specs.map(([term, value]) => (
      <div>
        <dt>{term}</dt>
        <dd>{value}</dd>
      </div>
    ))}
  </dl>
  </div>
</div>

<style>
  .blueprint-row {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--spacing_fluid-space-l-xl);
    margin-top: var(--spacing_fluid-space-2xl-3xl);
  }
  .blueprint {
    position: relative;
    padding: var(--spacing_fluid-space-m);
    border: 1px solid color-mix(in oklch, var(--palette-cyan-400) 25%, transparent);
    background: color-mix(in oklch, var(--palette-ink-950) 45%, transparent);
  }
  .blueprint::before,
  .blueprint::after {
    content: "";
    position: absolute;
    width: 22px;
    height: 22px;
    border: 2px solid var(--palette-cyan-400);
  }
  .blueprint::before {
    top: -2px;
    left: -2px;
    border-right: 0;
    border-bottom: 0;
  }
  .blueprint::after {
    right: -2px;
    bottom: -2px;
    border-left: 0;
    border-top: 0;
  }
  .blueprint-label {
    margin: 0 0 var(--spacing_fluid-space-2xs);
    font-family: var(--font-family-mono);
    font-size: var(--typography_fluid-text-xs);
    letter-spacing: var(--font-tracking-label);
    text-transform: uppercase;
    color: var(--palette-cyan-400);
  }
  .spec-sheet {
    width: 100%;
    padding: var(--spacing_fluid-space-s) var(--spacing_fluid-space-m);
    border: 1px solid color-mix(in oklch, var(--palette-cyan-400) 45%, transparent);
    background: color-mix(in oklch, var(--palette-ink-950) 70%, transparent);
    clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 18px 100%, 0 calc(100% - 18px));
  }
  .spec-title {
    margin: 0 0 var(--spacing_fluid-space-xs);
    font-family: var(--font-family-mono);
    font-size: var(--typography_fluid-text-xs);
    letter-spacing: var(--font-tracking-label);
    text-transform: uppercase;
    color: var(--palette-cyan-400);
  }
  dl {
    margin: 0;
    display: grid;
    gap: var(--spacing_fluid-space-3xs);
    font-family: var(--font-family-mono);
    font-size: var(--typography_fluid-text-xs);
  }
  dl div {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: var(--spacing_fluid-space-s);
    border-bottom: 1px dashed color-mix(in oklch, var(--palette-cyan-400) 18%, transparent);
    padding-bottom: var(--spacing_fluid-space-3xs);
  }
  dt {
    color: var(--palette-cream-400);
  }
  dd {
    margin: 0;
    color: var(--palette-cream-100);
  }

  @media (max-width: 900px) {
    .blueprint-row {
      grid-template-columns: minmax(0, 1fr);
    }
    dl div {
      grid-template-columns: 1fr;
      gap: var(--spacing_fluid-space-3xs);
    }
  }
</style>
