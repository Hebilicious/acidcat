---
import { highlight } from "../lib/highlight.ts";
import { catalogSnippets } from "../lib/snippets.ts";

const surfaces = [
  { id: "cli", label: "CLI", kind: "Command line", output: "home aircon power set --on" },
  { id: "mcp", label: "MCP", kind: "Tool for agents", output: "aircon.power.set  destructiveHint" },
  { id: "webmcp", label: "WebMCP", kind: "Tool in your web page", output: "modelContext.registerTool" },
  { id: "http", label: "HTTP", kind: "API endpoint", output: "POST /capabilities/aircon.power.set" },
  { id: "ts", label: "Programmatic", kind: "Access from code", output: "execute({ on: true })" },
];

const outletY = (index: number) => 50 + index * 90;
const pipePath = (index: number) => {
  const y = outletY(index);
  return `M0 230C120 230 120 ${y} 240 ${y}H400`;
};

const snippets = await catalogSnippets();
---

<section class="schematic" aria-labelledby="schematic-title">
  <div class="schematic-inner">
    <header class="section-head">
      <p class="eyebrow">Fig. 1 — From catalog to surfaces</p>
      <h2 id="schematic-title">One capability, <em>five surfaces</em></h2>
      <p class="lede">
        A capability is one entry in the catalog: its input, its failures and the targets that may call it. Each binding turns that entry into a surface. No surface has its own copy of the rules.
      </p>
    </header>

    <div class="engine-stage">
    <div class="machine" data-machine>
      <div class="engine-card">
        <div class="language-rail" role="group" aria-label="Catalog language">
          {snippets.map(snippet => (
            <button type="button" data-language={snippet.id} aria-label={`${snippet.id.toUpperCase()}, ${snippet.label}`} aria-controls={`fig1-${snippet.id}`} aria-pressed={snippet.id === "ts"}>
              {snippet.id.toUpperCase()}
            </button>
          ))}
        </div>
        <div class="engine-plate" data-catalog-screen>
          <span class="rivet" /><span class="rivet" /><span class="rivet" /><span class="rivet" />
          {snippets.map(snippet => (
            <div data-fig1-panel id={`fig1-${snippet.id}`} hidden={snippet.id !== "ts"}>
              <p class="plate-title">{snippet.source.split("/").pop()}</p>
              <div class="catalog-code" tabindex="0" role="region" aria-label={`${snippet.label} capability definition`} set:html={highlight(snippet.code, snippet.language)} />
            </div>
          ))}
        </div>
      </div>

      <svg class="manifold" viewBox="0 0 400 460" preserveAspectRatio="none" aria-hidden="true">
        {surfaces.map((surface, index) => (
          <g class="manifold-pipe" data-surface-pipe={surface.id}>
            <path class="m-shell" d={pipePath(index)} />
            <path class="m-glass" d={pipePath(index)} />
            <path class="m-flow" d={pipePath(index)} style={`animation-delay:${index * -0.35}s`} />
          </g>
        ))}
      </svg>

      <ol class="capsules">
        {surfaces.map((surface) => (
          <li class="capsule" data-surface={surface.id} tabindex="0">
            <span class="capsule-cap" aria-hidden="true" />
            <div class="capsule-body">
              <span class="capsule-label">{surface.label}</span>
              <span class="capsule-kind">{surface.kind}</span>
              <code class="capsule-output">{surface.output}</code>
            </div>
            <span class="capsule-cap" aria-hidden="true" />
          </li>
        ))}
      </ol>
    </div>

    </div>

  </div>
</section>

<style>
  .schematic {
    position: relative;
    padding-block: var(--spacing_fluid-space-3xl-4xl) var(--spacing_fluid-space-xl);
  }
  .schematic-inner {
    width: min(var(--layout-width-content), 100%);
    margin-inline: auto;
    padding-inline: var(--layout-gutter-inline);
  }

  .section-head h2 {
    max-width: 100%;
  }

  .machine {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(80px, 0.5fr) minmax(0, 1fr);
    align-items: center;
    margin-top: var(--spacing_fluid-space-2xl);
  }

  :global(.holo-canvas) {
    display: block;
    width: 100%;
    margin-top: var(--spacing_fluid-space-2xl);
  }
  .machine[hidden] {
    display: none;
  }
  :global(.holo-canvas) {
    aspect-ratio: 1200 / 624;
  }
  .engine-stage[data-layout="tall"] :global(.holo-canvas),
  .engine-stage[data-layout="tall"][data-engine="pending"] {
    aspect-ratio: 500 / 1170;
    max-width: 30rem;
    margin-inline: auto;
  }
  .engine-stage[data-layout="tall"] :global(.holo-canvas pre) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    tab-size: 2;
  }
  :global(.holo-canvas) > [drawable] {
    position: absolute;
    inset: 0 auto auto 0;
    box-sizing: border-box;
    margin: 0;
    border: none;
    background: transparent;
    box-shadow: none;
    transform: none;
    border-radius: 0;
  }
  :global(.holo-canvas) .engine-plate {
    padding: var(--spacing_fluid-space-m);
    display: grid;
    align-content: center;
  }
  :global(.holo-canvas) .rivet,
  :global(.holo-canvas) .capsule-cap {
    display: none;
  }
  :global(.holo-canvas) .capsule {
    display: grid;
    grid-template-columns: 1fr;
  }
  :global(.holo-canvas) .capsule-body {
    background: none;
    box-shadow: none;
    border: none;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    gap: 0 var(--spacing_fluid-space-s);
    padding: var(--spacing_fluid-space-2xs) var(--spacing_fluid-space-s);
    align-content: center;
  }
  :global(.holo-canvas) .capsule-label {
    grid-row: auto;
    font-size: var(--typography_fluid-display-s);
  }
  :global(.holo-canvas) .capsule-output {
    grid-column: span 2;
  }
  :global(.holo-canvas) .capsule-kind {
    color: var(--palette-brass-300);
  }
  :global(.holo-canvas) pre {
    white-space: pre-wrap;
    overflow: visible;
  }
  .engine-card {
    position: relative;
    padding: var(--spacing_fluid-space-2xs);
    border-radius: var(--radius-size-xl);
    background: linear-gradient(135deg, var(--palette-brass-200), var(--palette-brass-500) 40%, var(--palette-brass-700) 70%, var(--palette-brass-400));
    box-shadow:
      0 0 0 2px var(--palette-ink-900),
      0 30px 80px -30px color-mix(in oklch, var(--palette-acid-400) 35%, transparent),
      0 0 120px -40px color-mix(in oklch, var(--palette-cyan-400) 40%, transparent);
  }
  .engine-plate {
    position: relative;
    padding: var(--spacing_fluid-space-m) var(--spacing_fluid-space-m) var(--spacing_fluid-space-m);
    border-radius: 16px;
    background: radial-gradient(circle at 20% 0%, var(--palette-blueprint-800), var(--palette-ink-925) 70%);
    box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--palette-cream-100) 15%, transparent);
  }
  .rivet {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, var(--palette-brass-200), var(--palette-brass-600));
  }
  .rivet:nth-child(1) {
    top: 10px;
    left: 10px;
  }
  .rivet:nth-child(2) {
    top: 10px;
    right: 10px;
  }
  .rivet:nth-child(3) {
    bottom: 10px;
    left: 10px;
  }
  .rivet:nth-child(4) {
    bottom: 10px;
    right: 10px;
  }
  .plate-title {
    margin: 0 0 var(--spacing_fluid-space-s);
    font-family: var(--font-family-mono);
    font-size: var(--typography_fluid-text-xs);
    letter-spacing: var(--font-tracking-label);
    text-transform: uppercase;
    color: var(--palette-brass-300);
  }
  .engine-stage { position: relative; }
  .engine-stage[data-engine="pending"] {
    min-height: 0;
    overflow: clip;
    aspect-ratio: 1200 / 624;
    margin-top: var(--spacing_fluid-space-2xl);
  }
  .engine-stage[data-engine="pending"] > :global(*) {
    visibility: hidden;
  }
  .engine-stage[data-engine="pending"]::before {
    content: "";
    position: absolute;
    inset: 20% 30%;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in oklch, var(--palette-acid-400) 10%, transparent), transparent);
    animation: engine-warm 2.4s ease-in-out infinite;
  }
  @keyframes engine-warm {
    50% { opacity: 0.35; }
  }
  .engine-plate { min-width: 0; }
  .catalog-code { height: 17rem; overflow: auto; scrollbar-color: var(--palette-brass-600) transparent; }
  .catalog-code :global(pre) {
    font-family: var(--font-family-mono);
    font-size: var(--typography_fluid-text-xs);
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .language-rail {
    display: flex;
    justify-content: center;
    gap: var(--spacing_fluid-space-2xs);
    padding: var(--spacing_fluid-space-2xs);
    background: linear-gradient(var(--palette-ink-900), var(--palette-brass-800));
  }
  .language-rail button {
    flex: 1;
    min-height: 44px;
    cursor: pointer;
    font: inherit;
    font-family: var(--font-family-label);
    color: var(--palette-brass-200);
    border-radius: 45% 45% 18% 18%;
    border: 1px solid var(--palette-brass-600);
    border-bottom: 4px double var(--palette-brass-400);
    background: radial-gradient(ellipse at 29% 16%, var(--palette-brass-700), var(--palette-ink-925) 54%);
  }
  .language-rail button {
    transition: color 0.25s, box-shadow 0.35s, text-shadow 0.35s;
  }
  .language-rail button:hover {
    color: var(--palette-nixie-400);
    text-shadow: 0 0 8px currentColor;
  }
  .language-rail button[aria-pressed="true"] {
    color: var(--palette-nixie-200);
    text-shadow: 0 0 6px var(--palette-nixie-400), 0 0 16px var(--palette-nixie-400);
    box-shadow: 0 0 22px color-mix(in oklch, var(--palette-nixie-400) 70%, transparent), inset 0 0 18px color-mix(in oklch, var(--palette-nixie-400) 45%, transparent);
  }
  .language-rail button:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px color-mix(in oklch, var(--palette-cyan-400) 80%, transparent), 0 0 24px var(--palette-cyan-400);
  }
  .engine-stage > .language-rail { position: absolute; inset: 0; padding: 0; background: none; pointer-events: none; }
  .engine-stage > .language-rail button { position: absolute; pointer-events: auto; opacity: 0; min-height: 0; }
  .engine-stage > .language-rail button:focus-visible { outline: none; }
  :global(.holo-canvas) .plate-title { color: var(--palette-brass-300); }
  :global(.holo-canvas) .engine-plate { align-content: start; grid-template-columns: minmax(0, 1fr); }
  :global(.holo-canvas) .catalog-code { height: auto; overflow: visible; }
  .manifold {
    width: 100%;
    height: 460px;
    overflow: visible;
  }
  .m-shell {
    fill: none;
    stroke: var(--palette-brass-600);
    stroke-width: 16;
    vector-effect: non-scaling-stroke;
  }
  .m-glass {
    fill: none;
    stroke: var(--palette-ink-900);
    stroke-width: 9;
    vector-effect: non-scaling-stroke;
  }
  .m-flow {
    fill: none;
    stroke: var(--palette-acid-400);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 10 22;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 5px color-mix(in oklch, var(--palette-acid-400) 90%, transparent));
    animation: m-flow 1.4s linear infinite;
  }
  .manifold-pipe.is-active .m-flow {
    stroke: var(--palette-cyan-400);
    animation-duration: 0.5s;
    filter: drop-shadow(0 0 8px color-mix(in oklch, var(--palette-cyan-400) 100%, transparent));
  }
  @keyframes m-flow {
    to {
      stroke-dashoffset: -32;
    }
  }

  .capsules {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  .capsule {
    display: grid;
    grid-template-columns: 18px 1fr 18px;
    align-items: stretch;
    height: 72px;
    outline: none;
    cursor: default;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .capsule-cap {
    background: linear-gradient(180deg, var(--palette-brass-200), var(--palette-brass-500) 45%, var(--palette-brass-800));
    border: 2px solid var(--palette-ink-900);
  }
  .capsule-cap:first-child {
    border-radius: 14px 4px 4px 14px;
  }
  .capsule-cap:last-child {
    border-radius: 4px 14px 14px 4px;
  }
  .capsule-body {
    display: grid;
    grid-template-columns: 7.4rem minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: var(--spacing_fluid-space-s);
    align-items: center;
    padding: var(--spacing_fluid-space-2xs) var(--spacing_fluid-space-s);
    background: linear-gradient(180deg, color-mix(in oklch, var(--palette-acid-400) 10%, transparent), color-mix(in oklch, var(--palette-ink-900) 95%, transparent) 40%, color-mix(in oklch, var(--palette-acid-400) 8%, transparent));
    border-block: 2px solid var(--palette-ink-900);
    box-shadow: inset 0 1px 0 color-mix(in oklch, var(--palette-cream-100) 15%, transparent);
  }
  .capsule-label {
    grid-row: span 2;
    font-family: var(--font-family-display);
    font-size: var(--typography_fluid-display-m);
    font-weight: var(--typography-weight-display-bold);
    color: var(--palette-cream-100);
  }
  .capsule-kind {
    font-family: var(--font-family-mono);
    font-size: var(--typography_fluid-text-xs);
    letter-spacing: var(--font-tracking-label);
    text-transform: uppercase;
    color: var(--palette-cream-400);
  }
  .capsule-output {
    font-family: var(--font-family-mono);
    font-size: var(--typography_fluid-text-xs);
    color: var(--palette-acid-400);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .capsule:is(:hover, :focus-visible, .is-active) {
    transform: translateX(8px);
  }
  .capsule:is(:hover, :focus-visible, .is-active) .capsule-output {
    color: var(--palette-cyan-400);
  }
  .capsule:focus-visible .capsule-body {
    outline: 2px solid var(--palette-cyan-400);
    outline-offset: 2px;
  }

  @media (max-width: 900px) {
    .engine-plate pre, .capsule-output {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
    .machine {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .manifold {
      display: none;
    }
    .capsules {
      margin-top: var(--spacing_fluid-space-xl);
      padding-left: var(--spacing_fluid-space-s);
      border-left: 4px solid var(--palette-brass-600);
    }
    .capsule {
      height: auto;
      min-height: 72px;
    }
    .capsule-body {
      grid-template-columns: minmax(0, 1fr);
    }
    .capsule-label {
      grid-row: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .m-flow {
      animation: none;
    }
  }
</style>

<script>
  import { mountCatalogEngine } from "../lib/holo.ts";

  const machine = document.querySelector<HTMLElement>("[data-machine]");
  if (machine) {
    const buttons = machine.querySelectorAll<HTMLButtonElement>("button[data-language]");
    const panels = machine.querySelectorAll<HTMLElement>("[data-fig1-panel]");
    for (const button of buttons) button.addEventListener("click", () => {
      for (const other of buttons) other.setAttribute("aria-pressed", String(other === button));
      for (const panel of panels) panel.hidden = panel.id !== button.getAttribute("aria-controls");
      machine.dispatchEvent(new Event("languagechange"));
    });
    mountCatalogEngine(machine);
  }

  const announce = (id: string | null) => {
    document.dispatchEvent(new CustomEvent("acidcat:surface", { detail: id }));
    for (const pipe of document.querySelectorAll<SVGGElement>("[data-surface-pipe]")) {
      pipe.classList.toggle("is-active", pipe.dataset["surfacePipe"] === id);
    }
  };

  for (const capsule of document.querySelectorAll<HTMLElement>("[data-surface]")) {
    const id = capsule.dataset["surface"] ?? null;
    capsule.addEventListener("pointerenter", () => announce(id));
    capsule.addEventListener("focus", () => announce(id));
    capsule.addEventListener("pointerleave", () => announce(null));
    capsule.addEventListener("blur", () => announce(null));
  }
</script>
