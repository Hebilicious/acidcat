---
const { editUrl } = Astro.locals.starlightRoute;
---

{editUrl && (
  <a class="edit-link lg:sl-hidden" href={editUrl.href} target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-4-4L4 16z" /><path d="m13.5 6.5 4 4" /></svg>
    Edit page
  </a>
)}

<style>
  .edit-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing_fluid-space-xs);
    color: var(--palette-cream-400);
    font-size: var(--typography_fluid-text-s);
    text-decoration: none;
  }
  .edit-link:hover {
    color: var(--palette-acid-400);
  }
  svg {
    width: 1.1em;
    height: 1.1em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
