---
import MobileTableOfContents from "@astrojs/starlight/components/MobileTableOfContents.astro";
import TableOfContents from "@astrojs/starlight/components/TableOfContents.astro";

const route = Astro.locals.starlightRoute;
const issue = new URL("https://github.com/Hebilicious/acidcat/issues/new");
issue.searchParams.set("title", `Site: ${route.entry.data.title}`);
issue.searchParams.set("body", `Page: ${Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname}\n\n`);
---

{route.toc && (
  <>
    <div class="lg:sl-hidden"><MobileTableOfContents /></div>
    <div class="right-sidebar-panel sl-hidden lg:sl-block">
      <div class="sl-container">
        <TableOfContents />
        <div class="page-actions">
          {route.editUrl && (
            <a href={route.editUrl.href} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-4-4L4 16z" /><path d="m13.5 6.5 4 4" /></svg>
              Edit page
            </a>
          )}
          <a href={issue.href} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7.5v5.5M12 16.5v.01" /></svg>
            Report issue
          </a>
        </div>
      </div>
    </div>
  </>
)}

<style>
  .right-sidebar-panel {
    padding: var(--spacing_fluid-space-l) var(--sl-sidebar-pad-x);
  }
  .sl-container {
    width: calc(var(--sl-sidebar-width) - 2 * var(--sl-sidebar-pad-x));
  }
  .page-actions {
    display: grid;
    gap: var(--spacing_fluid-space-xs);
    margin-top: var(--spacing_fluid-space-l);
    padding-top: var(--spacing_fluid-space-m);
    border-top: 1px solid color-mix(in oklch, var(--palette-brass-400) 22%, transparent);
  }
  .page-actions a {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing_fluid-space-xs);
    color: var(--palette-cream-400);
    font-size: var(--typography_fluid-text-s);
    text-decoration: none;
  }
  .page-actions a:hover {
    color: var(--palette-acid-400);
  }
  .page-actions svg {
    width: 1.1em;
    height: 1.1em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (min-width: 72rem) {
    .sl-container {
      max-width: calc(((100vw - var(--sl-sidebar-width) - 2 * var(--sl-content-pad-x) - 2 * var(--sl-sidebar-pad-x)) * 0.25));
    }
  }
</style>
