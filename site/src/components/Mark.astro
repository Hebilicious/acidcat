---
import { gearPath } from "../lib/geometry.ts";

interface Props {
  readonly size?: number;
}

const { size = 36 } = Astro.props;
const ring = gearPath({ cx: 32, cy: 32, teeth: 16, outer: 31, root: 27.5, hole: 23 });
---

<svg class="mark" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <path d={ring} fill="#c9a227" fill-rule="evenodd" />
  <path d="M18 42L17 15L27 23H37L47 15L46 42C42 49 37 51 32 51C27 51 22 49 18 42Z" fill="#c9a227" stroke="#0b0e14" stroke-width="2.5" stroke-linejoin="round" />
  <path d="M20 19L26 24L21 30Z M44 19L38 24L43 30Z" fill="#6b3a16" />
  <path d="M22 33C24 29 29 29 30 33C28 35 24 35 22 33Z M42 33C40 29 35 29 34 33C36 35 40 35 42 33Z" fill="#b6ff3b" />
  <path d="M26 32V34 M38 32V34" stroke="#0b0e14" stroke-width="1.4" stroke-linecap="round" />
  <path d="M30 40H34L32 42.5Z" fill="#b87333" />
</svg>
