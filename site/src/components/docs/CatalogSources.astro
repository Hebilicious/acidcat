---
import { catalogLanguages } from "../../lib/ecosystem.ts";
import FileLink from "./FileLink.astro";

const prefix = "examples/aircon/";
const rows = catalogLanguages.map((language) => {
  if (!language.example.startsWith(prefix)) throw new Error(`site/src/lib/ecosystem.ts gives ${language.example} for ${language.label}, which is not in ${prefix}.`);
  return { language, file: language.example.slice(prefix.length) };
});
---

<table>
  <thead>
    <tr><th>Language</th><th>Source</th><th>Write the JSON, from <code>catalog/</code></th></tr>
  </thead>
  <tbody>
    {
      rows.map(({ language, file }) => (
        <tr>
          <td>{language.label}</td>
          <td><FileLink file={file} /></td>
          <td>{language.write.map((command) => <code>{command}</code>)}</td>
        </tr>
      ))
    }
  </tbody>
</table>
