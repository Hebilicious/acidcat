---
import { TabItem, Tabs } from "@astrojs/starlight/components";
import { catalogLanguages, cores, ownCore, syncKeys } from "../../lib/ecosystem.ts";

interface Props {
  readonly of: "catalog-languages" | "cores";
  readonly own?: boolean;
}

const { of, own = false } = Astro.props;

const entries = of === "catalog-languages" ? catalogLanguages : [...cores, ...(own ? [ownCore] : [])];
const syncKey = of === "catalog-languages" ? syncKeys.catalogLanguage : syncKeys.core;

const panels = await Promise.all(
  entries.map(async (entry) => {
    if (!Astro.slots.has(entry.id)) {
      throw new Error(`${Astro.url.pathname} has no tab for ${entry.label} ("${entry.id}"), which site/src/lib/ecosystem.ts lists. Add <Fragment slot="${entry.id}"> inside <EcosystemTabs of="${of}">.`);
    }
    return { label: entry.label, html: await Astro.slots.render(entry.id) };
  }),
);
---

<Tabs syncKey={syncKey}>
  {
    panels.map((panel) => (
      <TabItem label={panel.label}>
        <Fragment set:html={panel.html} />
      </TabItem>
    ))
  }
  <slot />
</Tabs>
