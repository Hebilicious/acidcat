---
import { inlineCode } from "../../lib/inline-code.ts";
import { Code, TabItem, Tabs } from "@astrojs/starlight/components";
import { catalogLanguages, cores, installCode, syncKeys } from "../../lib/ecosystem.ts";
import type { Install } from "../../lib/ecosystem.ts";
import PackageInstall from "./PackageInstall.astro";

interface Props {
  readonly of: "catalog-languages" | "cores";
}

const { of } = Astro.props;

interface Panel {
  readonly label: string;
  readonly packageName: string;
  readonly registry: string;
  readonly requires: readonly string[];
  readonly steps: readonly Install[];
}


const stepsOf = (install: readonly Install[], directory: string): Promise<Install[]> =>
  Promise.all(install.map(async (step) => (step.kind === "code" ? { ...step, code: await installCode(step, directory) } : step)));

const panels: Panel[] =
  of === "catalog-languages"
    ? await Promise.all(
        catalogLanguages.map(async (language) => ({ label: language.label, packageName: language.packageName, registry: language.registry, requires: [], steps: await stepsOf(language.install, language.directory) })),
      )
    : await Promise.all(cores.map(async (core) => ({ label: core.label, packageName: core.packageName, registry: core.registry, requires: core.requires, steps: await stepsOf(core.install, core.directory) })));
---

<Tabs syncKey={of === "catalog-languages" ? syncKeys.catalogLanguage : syncKeys.core}>
  {
    panels.map((panel) => (
      <TabItem label={panel.label}>
        {panel.requires.length > 0 && (
          <ul>
            {panel.requires.map((requirement) => (
              <li set:html={inlineCode(requirement)} />
            ))}
          </ul>
        )}
        {panel.steps.map((step) =>
          step.kind === "node" ? <PackageInstall packages={step.packages} dev={step.dev} /> : <Code code={step.code} lang={step.lang} />,
        )}
        <p>
          The package is <code>{panel.packageName}</code> on {panel.registry}.
        </p>
      </TabItem>
    ))
  }
</Tabs>
