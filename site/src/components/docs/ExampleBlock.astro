---
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import { Code } from "@astrojs/starlight/components";
import { repositoryRoot } from "../../lib/ecosystem.ts";
import { sourcePath } from "../../lib/example-files.ts";
import { pickFence } from "../../lib/markdown-fences.ts";

interface Props {
  readonly section: string;
  readonly language?: string;
  readonly match?: string;
  readonly example?: string;
}

const { section, language, match, example = "aircon" } = Astro.props;
const readme = sourcePath(example, "README.md");
const fence = pickFence(await readFile(join(repositoryRoot, readme), "utf8"), { section, language, match }, `${readme} (for ${Astro.url.pathname})`);
---

<Code code={fence.code} lang={fence.language} />
