---
import { getEntry } from "astro:content";
import { cores } from "../../lib/ecosystem.ts";

const pages = await Promise.all(
  cores.map(async (core) => {
    const id = `docs/examples/${core.id}`;
    if ((await getEntry("docs", id)) === undefined) {
      throw new Error(`site/src/content/docs/${id}.mdx does not exist. Each core in site/src/lib/ecosystem.ts has an example page.`);
    }
    return { core, href: `/${id}/` };
  }),
);
---

<ul>
  {
    pages.map(({ core, href }) => (
      <li>
        <a href={href}>The air conditioner on the {core.label} core</a>: {core.note}
      </li>
    ))
  }
</ul>
