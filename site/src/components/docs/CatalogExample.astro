---
import { Code, TabItem, Tabs } from "@astrojs/starlight/components";
import { catalogExamples } from "../../lib/catalog-examples.ts";
import type { CatalogSelection } from "../../lib/catalog-examples.ts";

type Props = CatalogSelection & { readonly title?: string };

const { title, ...selection } = Astro.props;
const examples = await catalogExamples(selection);
---

<Tabs syncKey="catalog-language">
  {
    examples.map((example) => (
      <TabItem label={example.label}>
        <Code code={example.code} lang={example.lang} title={title === undefined ? example.title : `${example.title}: ${title}`} />
      </TabItem>
    ))
  }
</Tabs>
