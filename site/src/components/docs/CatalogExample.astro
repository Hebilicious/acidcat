---
import { Code, TabItem, Tabs } from "@astrojs/starlight/components";
import { catalogExamples } from "../../lib/catalog-examples.ts";
import type { CatalogSelection } from "../../lib/catalog-examples.ts";
import { syncKeys } from "../../lib/ecosystem.ts";

type Props = CatalogSelection;

const examples = await catalogExamples(Astro.props);
---

<Tabs syncKey={syncKeys.catalogLanguage}>
  {
    examples.map((example) => (
      <TabItem label={example.label}>
        <Code code={example.code} lang={example.lang} title={example.title} />
      </TabItem>
    ))
  }
</Tabs>
