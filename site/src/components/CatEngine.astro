<style>
  .engine {
    margin: 0;
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }
  .engine svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .spin {
    transform-box: view-box;
    animation: spin 60s linear infinite;
  }
  .spin-slow {
    animation-duration: 240s;
  }
  .spin-rev-slower {
    animation-duration: 180s;
    animation-direction: reverse;
  }
  .spin-gear {
    animation-duration: 120s;
  }
  .spin-rev {
    animation-direction: reverse;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .orbit-text {
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.32em;
    fill: var(--brass-300);
    fill-opacity: 0.7;
  }

  .ring-track {
    fill: none;
    stroke: var(--cream);
    stroke-opacity: 0.14;
    stroke-width: 1;
  }
  .ring {
    fill: none;
    stroke-linecap: round;
    animation: orbit 14s linear infinite;
  }
  .ring-cyan {
    stroke: var(--cyan);
    stroke-width: 2.5;
    stroke-dasharray: 220 60 14 60;
    filter: drop-shadow(0 0 6px rgb(59 232 255 / 0.7));
  }
  .ring-acid {
    stroke: var(--acid);
    stroke-width: 2;
    stroke-dasharray: 4 18;
    animation-duration: 9s;
    animation-direction: reverse;
    filter: drop-shadow(0 0 5px rgb(182 255 59 / 0.8));
  }
  .ring-brass {
    stroke: var(--brass-400);
    stroke-width: 9;
    stroke-linecap: butt;
    stroke-dasharray: 150 420 90 400;
    animation-duration: 22s;
    filter: drop-shadow(0 2px 0 #4a380a) drop-shadow(0 0 10px rgb(201 162 39 / 0.35));
  }
  .ring-brass-hi {
    stroke: #fff1c2;
    stroke-width: 2.5;
    stroke-linecap: butt;
    stroke-dasharray: 150 420 90 400;
    animation-duration: 22s;
    transform: translateY(-2.5px);
    opacity: 0.8;
  }
  .piston-rod {
    animation: piston 3.4s ease-in-out infinite;
  }
  @keyframes piston {
    50% {
      transform: translateY(-14px);
    }
  }
  @keyframes orbit {
    to {
      stroke-dashoffset: -1060;
    }
  }

  .aura {
    fill: none;
    stroke: var(--acid);
    stroke-width: 10;
    stroke-linejoin: round;
    filter: blur(10px);
    opacity: 0.45;
    animation: aura 4.4s ease-in-out infinite;
  }
  @keyframes aura {
    50% {
      opacity: 0.75;
    }
  }

  .pipe-shell {
    fill: none;
    stroke: #8a6b14;
    stroke-width: 18;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pipe-glass {
    fill: none;
    stroke: #0b0e14;
    stroke-width: 11;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pipe-flow {
    fill: none;
    stroke: var(--acid);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 14 26;
    animation: flow 1.6s linear infinite;
    filter: drop-shadow(0 0 6px rgb(182 255 59 / 0.9));
    opacity: 0.85;
    transition: opacity 0.3s, stroke 0.3s;
  }
  .pipe.is-active .pipe-flow {
    stroke: var(--cyan);
    opacity: 1;
    animation-duration: 0.6s;
    filter: drop-shadow(0 0 8px rgb(59 232 255 / 1));
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -40;
    }
  }

  .terminal {
    cursor: pointer;
    transition: transform 0.3s;
  }
  .terminal-label {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    fill: var(--cream);
    letter-spacing: 0.04em;
  }
  .terminal-detail {
    font-family: var(--font-mono);
    font-size: 12px;
    fill: var(--acid);
  }
  .terminal-led {
    animation: blink 2.4s steps(2, jump-none) infinite;
  }
  .terminal.is-active .terminal-detail {
    fill: var(--cyan);
