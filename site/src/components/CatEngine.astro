---
import { circlePath, gearPath, polar, seeded, segmentsAlong, ticks } from "../lib/geometry.ts";
import type { Cubic } from "../lib/geometry.ts";

const dial = { cx: 500, cy: 450 };
const dialTicks = ticks(dial.cx, dial.cy, 430, 144, 7, 6);
const dialCross = [0, 90, 180, 270].map((degrees) => ({
  outer: polar(dial.cx, dial.cy, 470, degrees),
  inner: polar(dial.cx, dial.cy, 400, degrees),
  node: polar(dial.cx, dial.cy, 445, degrees),
}));

const bigGear = gearPath({ cx: dial.cx, cy: dial.cy, teeth: 90, outer: 372, root: 360, hole: 344 });
const satellites = [
  { cx: 150, cy: 210, teeth: 16, outer: 62, root: 52, hole: 18, speed: "18s", reverse: false },
  { cx: 232, cy: 300, teeth: 10, outer: 34, root: 27, hole: 9, speed: "11.25s", reverse: true },
  { cx: 860, cy: 300, teeth: 14, outer: 52, root: 43, hole: 14, speed: "16s", reverse: true },
];

const shoulderGear = gearPath({ cx: 420, cy: 425, teeth: 14, outer: 50, root: 41, hole: 9 });
const haunchGear = gearPath({ cx: 238, cy: 712, teeth: 18, outer: 64, root: 54, hole: 12 });
const haunchPinion = gearPath({ cx: 318, cy: 612, teeth: 9, outer: 27, root: 20, hole: 6 });
const reactorGear = gearPath({ cx: 0, cy: 0, teeth: 10, outer: 15, root: 11, hole: 4 });

const point = (x: number, y: number) => ({ x, y });
const tailCurves: Cubic[] = [
  [point(128, 838), point(52, 836), point(22, 902), point(108, 920)],
  [point(108, 920), point(200, 938), point(320, 936), point(428, 932)],
];
const tailSegments = segmentsAlong(tailCurves, 27);
const tailCoil = new Set([9, 10, 11]);
const tailPivot = tailSegments[7] ?? { x: 200, y: 930, angle: 0 };

const random = seeded(2140);
const sparks = Array.from({ length: 22 }, () => ({
  x: Math.round(200 + random() * 600),
  y: Math.round(560 + random() * 260),
  r: Math.round((1 + random() * 2.2) * 10) / 10,
  delay: `${Math.round(random() * 90) / 10}s`,
  duration: `${Math.round((5 + random() * 6) * 10) / 10}s`,
  drift: `${Math.round((random() - 0.5) * 80)}px`,
  cyan: random() > 0.6,
}));

const orbitText = "ONE CATALOG ✦ EVERY SURFACE ✦ CLI ✦ MCP ✦ HTTP ✦ WEBMCP ✦ TYPESCRIPT ✦ CONFORM ✦ ";

const terminals = [
  { id: "cli", label: "CLI", detail: "home --on", x: 96, y: 640, pipe: "M226 830H166Q96 830 96 760V676" },
  { id: "mcp", label: "MCP", detail: "tools/call", x: 904, y: 640, pipe: "M774 830H834Q904 830 904 760V676" },
  { id: "http", label: "HTTP", detail: "POST /capabilities", x: 96, y: 950, pipe: "M230 880H136Q96 880 96 914" },
  { id: "ts", label: "TypeScript", detail: "execute({ on })", x: 904, y: 950, pipe: "M770 880H864Q904 880 904 914" },
];

const rings = [
  { id: "a", cx: 520, cy: 470, rx: 350, ry: 92, tilt: -10, kind: "cyan" },
  { id: "b", cx: 520, cy: 650, rx: 318, ry: 72, tilt: 7, kind: "acid" },
  { id: "c", cx: 520, cy: 372, rx: 384, ry: 104, tilt: 4, kind: "brass" },
];
const ellipsePath = (rx: number, ry: number) => `M${-rx} 0A${rx} ${ry} 0 1 1 ${rx} 0A${rx} ${ry} 0 1 1 ${-rx} 0`;
---

<figure class="engine" data-engine aria-labelledby="engine-caption">
  <figcaption id="engine-caption" class="sr-only">
    A mechanical brass cat sits on a brass pedestal. Four glass pipes carry glowing acid from the pedestal to four terminals: CLI, MCP, HTTP and TypeScript.
  </figcaption>
  <svg viewBox="0 0 1000 1000" role="img" aria-labelledby="engine-caption" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="brass" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#f6e2a4" />
        <stop offset="0.35" stop-color="#d9b23c" />
        <stop offset="0.75" stop-color="#a7801a" />
        <stop offset="1" stop-color="#5e4609" />
      </linearGradient>
      <linearGradient id="brass-side" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#3d2e07" />
        <stop offset="0.2" stop-color="#a7801a" />
        <stop offset="0.42" stop-color="#f6e2a4" />
        <stop offset="0.58" stop-color="#d9b23c" />
        <stop offset="0.85" stop-color="#7a5c10" />
        <stop offset="1" stop-color="#2c2105" />
      </linearGradient>
      <linearGradient id="brass-dim" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#b8922a" />
        <stop offset="1" stop-color="#4a380a" />
      </linearGradient>
      <linearGradient id="copper" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#f0b98c" />
        <stop offset="0.5" stop-color="#b87333" />
        <stop offset="1" stop-color="#5a2e10" />
      </linearGradient>
      <linearGradient id="steel" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#0e0c09" />
        <stop offset="0.5" stop-color="#2b261d" />
        <stop offset="1" stop-color="#0e0c09" />
      </linearGradient>
      <linearGradient id="glass-dome" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#3a4a8c" />
        <stop offset="0.45" stop-color="#121a3a" />
        <stop offset="1" stop-color="#05070b" />
      </linearGradient>
      <linearGradient id="acid-panel" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#b6ff3b" stop-opacity="0.85" />
        <stop offset="0.5" stop-color="#4f8f12" stop-opacity="0.55" />
        <stop offset="1" stop-color="#0b1a05" stop-opacity="0.9" />
      </linearGradient>
      <radialGradient id="iris" cx="0.45" cy="0.5" r="0.6">
        <stop offset="0" stop-color="#f4ffd6" />
        <stop offset="0.35" stop-color="#b6ff3b" />
        <stop offset="1" stop-color="#3f7a07" />
      </radialGradient>
      <radialGradient id="core" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color="#fbffe8" />
        <stop offset="0.3" stop-color="#b6ff3b" />
        <stop offset="1" stop-color="#b6ff3b" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="floor-glow" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color="#b6ff3b" stop-opacity="0.45" />
        <stop offset="0.6" stop-color="#3be8ff" stop-opacity="0.08" />
        <stop offset="1" stop-color="#3be8ff" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="halo" cx="0.5" cy="0.45" r="0.5">
        <stop offset="0" stop-color="#3be8ff" stop-opacity="0.16" />
        <stop offset="0.55" stop-color="#b6ff3b" stop-opacity="0.05" />
        <stop offset="1" stop-color="#0b0e14" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="scan" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#3be8ff" stop-opacity="0" />
        <stop offset="0.85" stop-color="#3be8ff" stop-opacity="0.35" />
        <stop offset="1" stop-color="#e8fdff" stop-opacity="0.9" />
      </linearGradient>
      <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="6" result="blur" />
        <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
      <filter id="glow-soft" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="3" result="blur" />
        <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
      <filter id="steam-blur" x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur stdDeviation="9" />
      </filter>
      <path id="orbit-text-path" d={circlePath(dial.cx, dial.cy, 398)} />
      <clipPath id="ring-back"><rect x="-500" y="-300" width="1000" height="300" /></clipPath>
      <clipPath id="ring-front"><rect x="-500" y="0" width="1000" height="300" /></clipPath>

      <g id="cat-silhouette">
        <path d="M362 215C352 280 345 330 315 400C270 470 190 520 145 620C105 710 110 800 160 852L505 862L500 828L470 640L475 520C500 480 512 440 506 405C502 350 490 300 470 255Z" />
        <path d="M372 140C400 118 460 112 500 135C525 150 540 175 552 200L566 212C563 222 553 228 541 232C535 245 520 255 500 258C470 262 445 258 430 245C400 235 372 215 365 190C360 170 362 152 372 140Z" />
        <path d="M360 168L380 22L442 130Z" />
        <path d="M428 136L458 78L474 146Z" />
      </g>
      <clipPath id="cat-clip"><use href="#cat-silhouette" /></clipPath>
    </defs>

    <circle class="halo" cx={dial.cx} cy={dial.cy} r="480" fill="url(#halo)" />

    <g class="dial">
      <g class="spin spin-slow" style={`transform-origin:${dial.cx}px ${dial.cy}px`}>
        <circle cx={dial.cx} cy={dial.cy} r="430" fill="none" stroke="#f2e6c9" stroke-opacity="0.18" stroke-width="1" />
        {dialTicks.map((tick) => (
          <line x1={tick.from.x} y1={tick.from.y} x2={tick.to.x} y2={tick.to.y} stroke="#f2e6c9" stroke-opacity={tick.major ? 0.45 : 0.16} stroke-width={tick.major ? 1.6 : 1} />
        ))}
      </g>
      <circle cx={dial.cx} cy={dial.cy} r="452" fill="none" stroke="#f2e6c9" stroke-opacity="0.22" stroke-dasharray="2 10 60 10" />
      {dialCross.map((cross) => (
        <g stroke="#f2e6c9" stroke-opacity="0.5" fill="none">
          <line x1={cross.outer.x} y1={cross.outer.y} x2={cross.inner.x} y2={cross.inner.y} />
          <circle cx={cross.node.x} cy={cross.node.y} r="6" fill="#0b0e14" />
        </g>
      ))}
      <g class="spin spin-rev-slower" style={`transform-origin:${dial.cx}px ${dial.cy}px`}>
        <text class="orbit-text">
          <textPath href="#orbit-text-path">{orbitText}{orbitText}</textPath>
        </text>
      </g>
      <g class="spin spin-gear" style={`transform-origin:${dial.cx}px ${dial.cy}px`}>
        <path d={bigGear} fill="url(#brass-dim)" fill-opacity="0.32" fill-rule="evenodd" stroke="#c9a227" stroke-opacity="0.35" />
      </g>
    </g>

    <g class="satellites">
      {satellites.map((gear) => (
        <g>
          <g class:list={["spin", gear.reverse ? "spin-rev" : "spin-fwd"]} style={`transform-origin:${gear.cx}px ${gear.cy}px;animation-duration:${gear.speed}`}>
            <path d={gearPath(gear)} fill="none" stroke="#f2e6c9" stroke-opacity="0.55" stroke-width="2" fill-rule="evenodd" />
            <line x1={gear.cx} y1={gear.cy} x2={gear.cx} y2={gear.cy - gear.root + 6} stroke="#f2e6c9" stroke-opacity="0.55" stroke-width="2" />
          </g>
          <line x1={gear.cx - gear.outer - 24} y1={gear.cy} x2={gear.cx + gear.outer + 24} y2={gear.cy} stroke="#f2e6c9" stroke-opacity="0.2" />
          <line x1={gear.cx} y1={gear.cy - gear.outer - 24} x2={gear.cx} y2={gear.cy + gear.outer + 24} stroke="#f2e6c9" stroke-opacity="0.2" />
        </g>
      ))}
    </g>

    {rings.map((ring) => (
      <g transform={`translate(${ring.cx} ${ring.cy}) rotate(${ring.tilt})`} clip-path="url(#ring-back)">
        <path class="ring-track" d={ellipsePath(ring.rx, ring.ry)} />
        <path class:list={["ring", `ring-${ring.kind}`]} d={ellipsePath(ring.rx, ring.ry)} />
        {ring.kind === "brass" && <path class="ring ring-brass-hi" d={ellipsePath(ring.rx, ring.ry)} />}
      </g>
    ))}

    <g class="pipes">
      {terminals.map((terminal) => (
        <g class="pipe" data-pipe={terminal.id}>
          <path class="pipe-shell" d={terminal.pipe} />
          <path class="pipe-glass" d={terminal.pipe} />
          <path class="pipe-flow" d={terminal.pipe} />
        </g>
      ))}
    </g>

    <ellipse cx="500" cy="950" rx="340" ry="64" fill="url(#floor-glow)" class="floor-glow" />

    <g class="pedestal">
      <path d="M220 800V880C220 916 345 940 500 940C655 940 780 916 780 880V800Z" fill="url(#brass-side)" stroke="#0b0e14" stroke-width="3" />
      <path d="M220 852C220 886 345 910 500 910C655 910 780 886 780 852" fill="none" stroke="#0b0e14" stroke-width="2" stroke-opacity="0.7" />
      <path d="M220 824C220 858 345 882 500 882C655 882 780 858 780 824" fill="none" stroke="#f6e2a4" stroke-width="1.2" stroke-opacity="0.5" />
      {Array.from({ length: 15 }, (_, index) => {
        const angle = Math.PI * (0.06 + (0.88 * index) / 14);
        const x = 500 - Math.cos(angle) * 272;
        const y = 893 + Math.sin(angle) * 36;
        return <circle cx={Math.round(x)} cy={Math.round(y)} r="3" fill="#f6e2a4" stroke="#3d2e07" />;
      })}
      <ellipse cx="500" cy="800" rx="280" ry="56" fill="url(#brass)" stroke="#0b0e14" stroke-width="3" />
      <ellipse cx="500" cy="800" rx="246" ry="45" fill="#0b0e14" fill-opacity="0.55" stroke="#c9a227" stroke-opacity="0.6" />
      <ellipse class="plate-glow" cx="500" cy="800" rx="206" ry="35" fill="none" stroke="#b6ff3b" stroke-width="2" stroke-dasharray="6 10" filter="url(#glow-soft)" />
      <g class="gauge" transform="translate(500 884)">
        <circle r="30" fill="#f2e6c9" stroke="#0b0e14" stroke-width="3" />
        <circle r="30" fill="none" stroke="url(#brass-side)" stroke-width="7" />
        {Array.from({ length: 11 }, (_, index) => {
          const from = polar(0, 0, 21, -120 + index * 24);
          const to = polar(0, 0, index % 5 === 0 ? 14 : 17, -120 + index * 24);
          return <line x1={from.x} y1={from.y} x2={to.x} y2={to.y} stroke="#0b0e14" stroke-width={index % 5 === 0 ? 2 : 1} />;
        })}
        <path d="M-7 -4A9 9 0 0 1 7 -4" fill="none" stroke="#ff4d2e" stroke-width="2" transform="rotate(64)" />
        <g class="needle"><line x1="0" y1="4" x2="0" y2="-20" stroke="#0b0e14" stroke-width="2.2" stroke-linecap="round" /></g>
        <circle r="3.5" fill="#b87333" stroke="#0b0e14" />
      </g>
      {[-1, 1].map((side) => (
        <g transform={`translate(${500 + side * 124} 868)`}>
          <rect x="-13" y="-30" width="26" height="54" rx="12" fill="#0b0e14" fill-opacity="0.7" stroke="#f2e6c9" stroke-opacity="0.6" stroke-width="1.5" />
          <rect class="vial" x="-8" y="-24" width="16" height="44" rx="8" fill="#b6ff3b" filter="url(#glow-soft)" style={`animation-delay:${side > 0 ? "-1.6s" : "0s"}`} />
          <rect x="-16" y="20" width="32" height="8" rx="2" fill="url(#brass-side)" stroke="#0b0e14" stroke-width="1.5" />
          <rect x="-16" y="-36" width="32" height="8" rx="2" fill="url(#brass-side)" stroke="#0b0e14" stroke-width="1.5" />
        </g>
      ))}
      {[-1, 1].map((side) => (
        <g transform={`translate(${500 + side * 216} 852)`}>
          {[0, 1, 2].map((slot) => (
            <rect x="-14" y={-12 + slot * 9} width="28" height="4" rx="2" fill="#0b0e14" fill-opacity="0.85" />
          ))}
        </g>
      ))}
    </g>

    <g class="steam" filter="url(#steam-blur)">
      {[0, 1, 2, 3, 4, 5].map((index) => (
        <circle class="puff" cx={index % 2 === 0 ? 284 : 716} cy="840" r="24" style={`animation-delay:${index * 1.1}s`} />
      ))}
    </g>

    <g class="cat" transform="translate(272 96) scale(0.8)">
      <use class="aura" href="#cat-silhouette" />
      <g class="cat-body">
        <path d="M428 136L458 78L474 146Z" fill="url(#brass-dim)" stroke="#0b0e14" stroke-width="4" stroke-linejoin="round" />

        <g class="leg-far">
          <path d="M352 560L398 560L404 828L352 828Z" fill="url(#brass-dim)" stroke="#0b0e14" stroke-width="4" />
          <path d="M340 862C338 838 356 826 380 826C404 826 418 840 414 862Z" fill="url(#brass-dim)" stroke="#0b0e14" stroke-width="4" />
        </g>

        <path d="M362 215C352 280 345 330 315 400C270 470 190 520 145 620C105 710 110 800 160 852L505 862L500 828L470 640L475 520C500 480 512 440 506 405C502 350 490 300 470 255Z" fill="url(#steel)" stroke="#0b0e14" stroke-width="5" stroke-linejoin="round" />

        <g class="spine" stroke="#c9a227" stroke-opacity="0.75" stroke-width="3" stroke-linecap="round">
          {[0, 1, 2, 3, 4, 5, 6].map((index) => (
            <line x1={372 + index * 2} y1={232 + index * 15} x2={428 + index * 4} y2={238 + index * 15} />
          ))}
          <path d="M404 230C400 270 400 300 404 330" fill="none" stroke="#3be8ff" stroke-opacity="0.6" stroke-width="2" />
        </g>

        <path d="M300 520C340 498 400 496 434 516L474 640C420 652 360 644 320 622Z" fill="url(#brass)" stroke="#0b0e14" stroke-width="4" stroke-linejoin="round" />
        <path class="filigree" d="M330 560C340 546 358 544 364 556C368 566 356 570 350 562M380 590C392 580 408 582 410 594M352 610C364 604 378 606 384 616" fill="none" stroke="#7a3c14" stroke-width="2.5" stroke-linecap="round" />
        <path d="M432 252C452 262 466 258 474 254C486 280 492 305 494 332L436 342C434 310 432 280 432 252Z" fill="url(#brass)" stroke="#0b0e14" stroke-width="4" stroke-linejoin="round" />
        {[276, 298, 320].map((y) => (
          <path d={`M${434} ${y}L${486 + (y - 276) * 0.25} ${y - 6}`} stroke="#0b0e14" stroke-width="2" stroke-opacity="0.7" />
        ))}

        <path class="acid-panel" d="M330 345C290 440 180 515 132 640C112 705 118 750 136 790C160 712 200 610 268 525C318 468 345 420 354 370Z" fill="url(#acid-panel)" stroke="#0b0e14" stroke-width="4" filter="url(#glow-soft)" />
        <path d="M318 400C280 460 210 520 170 600" fill="none" stroke="#f4ffd6" stroke-opacity="0.55" stroke-width="3" stroke-linecap="round" class="acid-glint" />

        <path d="M346 372C330 420 300 470 262 520C230 562 200 600 182 650L236 600C280 560 330 520 372 470Z" fill="url(#brass)" stroke="#0b0e14" stroke-width="4" stroke-linejoin="round" />
        <path d="M262 556C236 590 214 620 198 650" fill="none" stroke="#b87333" stroke-width="3" stroke-linecap="round" />

        <g class="shoulder">
          <circle cx="420" cy="425" r="84" fill="url(#brass)" stroke="#0b0e14" stroke-width="5" />
          <path d="M346 400A78 78 0 0 1 470 362" fill="none" stroke="url(#copper)" stroke-width="12" stroke-linecap="round" />
          <path class="filigree" d="M360 392C366 378 380 372 390 380C398 388 388 398 380 392M402 372C412 364 428 364 436 374C442 384 430 390 424 382" fill="none" stroke="#5a2e10" stroke-width="2.5" stroke-linecap="round" />
          <circle cx="420" cy="425" r="56" fill="#0b0e14" stroke="#0b0e14" stroke-width="3" />
          <g class="spin spin-fwd" style="transform-origin:420px 425px;animation-duration:12s">
            <path d={shoulderGear} fill="url(#brass-dim)" fill-rule="evenodd" stroke="#0b0e14" stroke-width="2" />
            {[0, 60, 120, 180, 240, 300].map((degrees) => {
              const spoke = polar(420, 425, 30, degrees);
              return <line x1="420" y1="425" x2={spoke.x} y2={spoke.y} stroke="#0b0e14" stroke-width="3" />;
            })}
          </g>
          <circle cx="420" cy="425" r="56" fill="none" stroke="#f6e2a4" stroke-opacity="0.4" stroke-width="2" />
        </g>

        <g class="piston">
          <rect class="piston-rod" x="376" y="740" width="12" height="86" rx="3" fill="#d8dde6" stroke="#0b0e14" stroke-width="3" />
          <rect x="370" y="640" width="24" height="120" rx="5" fill="url(#brass-dim)" stroke="#0b0e14" stroke-width="3.5" />
          <circle cx="382" cy="650" r="5" fill="#b87333" stroke="#0b0e14" stroke-width="2" />
          <path d="M398 660C410 700 404 760 416 820" fill="none" stroke="#3be8ff" stroke-opacity="0.7" stroke-width="2" />
        </g>

        <g class="haunch">
          <circle cx="240" cy="715" r="120" fill="url(#brass)" stroke="#0b0e14" stroke-width="5" />
          <path d="M132 690A110 110 0 0 1 320 628" fill="none" stroke="url(#copper)" stroke-width="16" stroke-linecap="round" />
          <path class="filigree" d="M150 668C158 650 176 644 186 654C194 664 182 674 174 666M200 636C214 628 232 630 240 642C246 654 232 660 226 650M262 630C276 626 290 632 294 644" fill="none" stroke="#5a2e10" stroke-width="2.5" stroke-linecap="round" />
          <circle cx="240" cy="715" r="84" fill="#0b0e14" stroke="#0b0e14" stroke-width="3" />
          <g class="spin spin-rev" style="transform-origin:238px 712px;animation-duration:16s">
            <path d={haunchGear} fill="url(#brass-dim)" fill-rule="evenodd" stroke="#0b0e14" stroke-width="2" />
            {[0, 72, 144, 216, 288].map((degrees) => {
              const spoke = polar(238, 712, 42, degrees);
              return <line x1="238" y1="712" x2={spoke.x} y2={spoke.y} stroke="#0b0e14" stroke-width="4" />;
            })}
          </g>
          <g class="spin spin-fwd" style="transform-origin:318px 612px;animation-duration:8s">
            <path d={haunchPinion} fill="url(#copper)" fill-rule="evenodd" stroke="#0b0e14" stroke-width="2" />
          </g>
          <path d="M244 846C300 846 350 806 352 744C354 700 330 664 300 650C320 690 322 730 300 770C280 806 250 830 196 840C210 846 226 848 244 846Z" fill="url(#brass)" stroke="#0b0e14" stroke-width="4" stroke-linejoin="round" />
          <circle cx="240" cy="715" r="84" fill="none" stroke="#f6e2a4" stroke-opacity="0.35" stroke-width="2" />
        </g>

