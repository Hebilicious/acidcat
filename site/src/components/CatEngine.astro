  .vial {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: vial 3.2s ease-in-out infinite;
  }
  @keyframes vial {
    0%,
    100% {
      transform: scaleY(0.45);
    }
    50% {
      transform: scaleY(0.95);
    }
  }

  .needle {
    animation: needle 5s ease-in-out infinite;
  }
  @keyframes needle {
    0%,
    100% {
      transform: rotate(-70deg);
    }
    40% {
      transform: rotate(48deg);
    }
    55% {
      transform: rotate(38deg);
    }
    70% {
      transform: rotate(56deg);
    }
  }

  .plate-glow {
    animation: orbit 30s linear infinite;
  }
  .floor-glow {
    animation: breathe 4s ease-in-out infinite;
  }

  .puff {
    fill: var(--cream);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: puff 6.6s ease-out infinite;
  }
  @keyframes puff {
    0% {
      opacity: 0;
      transform: translateY(0) scale(0.4);
    }
    15% {
      opacity: 0.5;
    }
    100% {
      opacity: 0;
      transform: translateY(-220px) scale(3.2);
    }
  }

  .spark {
    opacity: 0;
    animation: spark 8s ease-in infinite;
  }
  @keyframes spark {
    0% {
      opacity: 0;
      transform: translate(0, 0);
    }
    20% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
      transform: translate(var(--drift), -420px);
    }
  }

  .acid-panel {
    animation: acid 5s ease-in-out infinite;
  }
  @keyframes acid {
    0%,
    100% {
      fill-opacity: 0.75;
    }
    50% {
      fill-opacity: 1;
    }
  }
  .acid-glint {
    stroke-dasharray: 60 400;
    animation: glint 4.5s ease-in-out infinite;
  }
  @keyframes glint {
    from {
      stroke-dashoffset: 120;
    }
    to {
      stroke-dashoffset: -340;
    }
  }

  .reactor-halo {
    transform-box: fill-box;
    transform-origin: center;
    animation: pulse 2.2s ease-in-out infinite;
  }
  .reactor-core {
    animation: breathe 2.2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%,
    100% {
      transform: scale(0.8);
      opacity: 0.55;
    }
    50% {
      transform: scale(1.15);
      opacity: 1;
    }
  }
  @keyframes breathe {
    0%,
    100% {
      opacity: 0.7;
    }
    50% {
      opacity: 1;
    }
  }

  .tail-tip {
    transform-box: view-box;
    animation: tail 7s ease-in-out infinite;
  }
  @keyframes tail {
    0%,
    100% {
      transform: rotate(0deg);
    }
    35% {
      transform: rotate(-4deg);
    }
    45% {
      transform: rotate(1.5deg);
    }
    55% {
      transform: rotate(-2.5deg);
    }
  }
  .blade-glow {
    animation: breathe 1.8s ease-in-out infinite;
  }

  .head {
    transform-box: view-box;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
    transform: rotate(var(--head-tilt, 0deg));
  }
  .ear {
    transform-box: view-box;
    animation: twitch 9s ease-in-out infinite;
  }
  @keyframes twitch {
    0%,
    88%,
    100% {
      transform: rotate(0deg);
    }
    91% {
      transform: rotate(-9deg);
    }
    94% {
      transform: rotate(3deg);
    }
  }
  .ear-node {
    animation: blink 3s steps(2, jump-none) infinite;
  }

  .lid {
    transform-box: fill-box;
    transform-origin: 50% 0%;
    transform: scaleY(0.25);
    animation: lid 6s ease-in-out infinite;
  }
  @keyframes lid {
    0%,
    92%,
    100% {
      transform: scaleY(0.25);
    }
    95% {
      transform: scaleY(1.25);
    }
  }
  .pupil {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.4s;
    transform: translateX(var(--pupil-x, 0px)) scaleX(var(--pupil-dilate, 1));
  }
  .whisker-tip {
    animation: breathe 2.6s ease-in-out infinite;
  }

  .scan {
    animation: scan 6s cubic-bezier(0.6, 0, 0.4, 1) infinite;
    mix-blend-mode: screen;
  }
  @keyframes scan {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    55% {
      transform: translateY(1080px);
      opacity: 1;
    }
    56%,
    100% {
      transform: translateY(1080px);
      opacity: 0;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }

  .engine.is-paused * {
    animation-play-state: paused !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .engine * {
      animation: none !important;
      transition: none !important;
    }
    .spark,
    .puff,
    .scan {
      display: none;
    }
  }
</style>

<script>
  const engines = document.querySelectorAll<HTMLElement>("[data-engine]");

  for (const engine of engines) {
    const head = engine.querySelector<SVGGElement>(".head");
    const svg = engine.querySelector("svg");

    const visibility = new IntersectionObserver(([entry]) => {
      engine.classList.toggle("is-paused", entry !== undefined && !entry.isIntersecting);
    });
    visibility.observe(engine);

    const fine = window.matchMedia("(pointer: fine)");
    if (head !== null && svg !== null && fine.matches) {
      window.addEventListener(
        "pointermove",
        (event) => {
          const box = svg.getBoundingClientRect();
          const dx = (event.clientX - (box.left + box.width * 0.56)) / window.innerWidth;
          const dy = (event.clientY - (box.top + box.height * 0.3)) / window.innerHeight;
          const tilt = Math.max(-7, Math.min(7, dy * 18 - dx * 4));
          engine.style.setProperty("--head-tilt", `${tilt.toFixed(2)}deg`);
          engine.style.setProperty("--pupil-x", `${Math.max(-2.5, Math.min(2.5, dx * 8)).toFixed(2)}px`);
        },
        { passive: true },
      );
    }

    const setActive = (id: string | null) => {
      for (const element of engine.querySelectorAll<SVGGElement>("[data-pipe], [data-terminal]")) {
        const own = element.dataset["pipe"] ?? element.dataset["terminal"];
        element.classList.toggle("is-active", own === id);
      }
      engine.style.setProperty("--pupil-dilate", id === null ? "1" : "2.2");
    };

    for (const terminal of engine.querySelectorAll<SVGGElement>("[data-terminal]")) {
      terminal.addEventListener("pointerenter", () => setActive(terminal.dataset["terminal"] ?? null));
      terminal.addEventListener("pointerleave", () => setActive(null));
    }

    document.addEventListener("acidcat:surface", (event) => {
      setActive(event instanceof CustomEvent && typeof event.detail === "string" ? event.detail : null);
    });
  }
</script>
