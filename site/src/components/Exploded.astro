---
const parts = [
  { id: "catalog", numeral: "I", name: "Catalog", note: "the contract, in JSON", height: 258 },
  { id: "bindings", numeral: "II", name: "Bindings", note: "rules for each surface", height: 263 },
  { id: "core", numeral: "III", name: "Core", note: "runs the capabilities", height: 316 },
  { id: "conform", numeral: "IV", name: "acid-cat conform", note: "tests from the outside", height: 325 },
];
---

<figure class="engine-study" aria-label="Exploded view of the catalog, bindings, core and acid-cat conform">
  <ol role="list">
    {parts.map((part) => (
      <li>
        <div class="specimen">
          <img src={`/exploded/${part.id}.webp`} alt="" width="560" height={part.height} loading="lazy" />
        </div>
        <div class="annotation">
          <span class="numeral">{part.numeral}</span>
          <strong>{part.name}</strong>
          <span class="note">{part.note}</span>
        </div>
      </li>
    ))}
  </ol>
</figure>

<style>
  .engine-study {
    margin: 0;
    container-type: inline-size;
  }
  ol {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 1.25rem 0;
    display: grid;
    gap: clamp(1rem, 3cqw, 1.4rem);
    background: radial-gradient(ellipse at 30% 53%, color-mix(in oklch, var(--palette-brass-500) 6%, transparent), transparent 62%);
  }
  ol::before {
    position: absolute;
    content: "";
    inset: 0 auto 0 30%;
    border-left: 1px dashed color-mix(in oklch, var(--palette-cyan-400) 38%, transparent);
  }
  li {
    position: relative;
    display: grid;
    grid-template-columns: 60% minmax(0, 1fr);
    align-items: center;
    --anchor: 79%;
  }
  li:nth-child(2) { --anchor: 94%; }
  li:nth-child(4) { --anchor: 86%; }
  .specimen {
    position: relative;
    display: grid;
    justify-items: center;
  }
  img {
    width: 84%;
    height: auto;
    display: block;
    position: relative;
  }
  .specimen::after {
    position: absolute;
    content: "";
    top: 50%;
    left: var(--anchor);
    right: 0;
    border-top: 1px solid color-mix(in oklch, var(--palette-brass-300) 60%, transparent);
  }
  .specimen::before {
    position: absolute;
    z-index: 1;
    content: "";
    left: var(--anchor);
    top: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: var(--palette-brass-200);
  }
  .annotation {
    padding-left: clamp(0.6rem, 2.5cqw, 1rem);
    display: grid;
    gap: 0.25rem;
  }
  .numeral {
    font: 500 0.76rem/1.2 var(--font-mono);
    letter-spacing: 0.12em;
    color: var(--palette-cyan-400);
  }
  strong {
    font: 500 clamp(1.12rem, 4cqw, 1.65rem)/1.08 var(--font-display);
    color: var(--palette-cream-100);
  }
  .note {
    font: 400 clamp(0.78rem, 2.5cqw, 0.95rem)/1.3 var(--font-sans);
    color: var(--palette-cream-400);
  }
  @media (prefers-reduced-motion: no-preference) {
    img { animation: suspend 7s ease-in-out infinite alternate; }
    li:nth-child(even) img { animation-direction: alternate-reverse; }
    li:nth-child(3) img { animation-delay: -3s; }
    @keyframes suspend {
      from { transform: translateY(-2px); }
      to { transform: translateY(2px); }
    }
  }
</style>
